// Allow the agent team to deploy the PGU board without blanket sudo.
// Scope is intentionally limited to the live board unit and deploy canaries.
polkit.addRule(function(action, subject) {
    if (subject.user !== "agent") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit === "pgu-ticket-board.service") {
        if (verb === "start" || verb === "stop" || verb === "restart") {
            return polkit.Result.YES;
        }
        return polkit.Result.NOT_HANDLED;
    }

    if (/^pgu-ticket-board-canary-[A-Za-z0-9_.@:-]+\.service$/.test(unit)) {
        if (verb === "start" || verb === "stop") {
            return polkit.Result.YES;
        }
    }

    return polkit.Result.NOT_HANDLED;
});
