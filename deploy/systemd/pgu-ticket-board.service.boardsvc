[Unit]
Description=PGU Ticket Board
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=boardsvc
WorkingDirectory=/home/agent/pgu-ticketboard-live/current
ExecStart=/usr/bin/python3 /home/agent/pgu-ticketboard-live/current/scripts/ticket-board.py --host 127.0.0.1 --port 8770 --store-backend postgres --frames /tmp/pgu-frames --assets /home/agent/.claude/pgu-tickets-assets
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/agent
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=pgu
Environment=PGUSER=ticket_board_service
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/agent/.claude/pgu-tickets-assets /tmp/pgu-frames
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
