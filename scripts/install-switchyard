#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_PATH="${SWITCHYARD_SOURCE_PATH:-${PGU_SWITCHYARD_SOURCE_PATH:-$REPO_ROOT/switchyard}}"
INSTALL_PATH="${SWITCHYARD_INSTALL_PATH:-${PGU_SWITCHYARD_INSTALL_PATH:-/usr/local/bin/switchyard}}"
SUDO_BIN="${SWITCHYARD_SUDO_BIN:-sudo}"

mode="print"

usage() {
    cat <<'EOF'
Usage: scripts/install-switchyard [--print-commands|--apply]

Installs the public switchyard command on a system PATH as a tiny trampoline to
the live checkout entrypoint. The default mode prints the privileged command
block for an operator to run; --apply performs it and is intended to be run
under sudo.

Environment overrides:
  SWITCHYARD_SOURCE_PATH   source entrypoint, default: <repo>/switchyard
  SWITCHYARD_INSTALL_PATH  installed command path, default: /usr/local/bin/switchyard
EOF
}

die() {
    printf 'install-switchyard: ERROR: %s\n' "$*" >&2
    exit 1
}

quote() {
    printf '%q' "$1"
}

while (($#)); do
    case "$1" in
        --print-commands)
            mode="print"
            ;;
        --apply)
            mode="apply"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

secure_path_contains_install_dir() {
    local install_dir="$1"
    local secure_path
    secure_path="$("$SUDO_BIN" -V 2>/dev/null | awk '
        tolower($0) ~ /secure path/ || tolower($0) ~ /override.*path/ {
            sub(/^[^:]*:[ \t]*/, "", $0)
            print $0
            exit
        }
    ')"
    if [[ -z "$secure_path" ]]; then
        return 0
    fi
    [[ ":$secure_path:" == *":$install_dir:"* ]]
}

write_wrapper() {
    local target="$1"
    local destination="$2"
    local help_text
    local tmp
    local version_text
    help_text="$("$target" --help)"
    version_text="$("$target" --version)"
    tmp="$(mktemp "${destination}.tmp.XXXXXX")"
    cat >"$tmp" <<EOF
#!/usr/bin/env bash
set -euo pipefail

readonly SWITCHYARD_TARGET=$(quote "$target")
readonly SWITCHYARD_SUDO_BIN="\${SWITCHYARD_SUDO_BIN:-sudo}"
export PYTHONDONTWRITEBYTECODE="\${PYTHONDONTWRITEBYTECODE:-1}"

switchyard_print_help() {
    if [[ -x "\$SWITCHYARD_TARGET" ]]; then
        exec "\$SWITCHYARD_TARGET" --help
    fi
    cat <<'HELPEOF'
$help_text
HELPEOF
}

switchyard_print_version() {
    if [[ -x "\$SWITCHYARD_TARGET" ]]; then
        exec "\$SWITCHYARD_TARGET" --version
    fi
    cat <<'VERSIONEOF'
$version_text
VERSIONEOF
}

switchyard_target_invocation_requires_root() {
    local classification
    if [[ ! -x "\$SWITCHYARD_TARGET" ]]; then
        return 2
    fi
    if ! classification="\$("\$SWITCHYARD_TARGET" --switchyard-wrapper-requires-root "\$@" 2>/dev/null)"; then
        return 2
    fi
    case "\$classification" in
        requires-root)
            return 0
            ;;
        no-root)
            return 1
            ;;
        *)
            return 2
            ;;
    esac
}

switchyard_invocation_requires_root() {
    if [[ "\$#" -eq 0 ]]; then
        return 1
    fi
    if switchyard_target_invocation_requires_root "\$@"; then
        return 0
    fi
    case "\$?" in
        1)
            return 1
            ;;
    esac
    case "\$1" in
        -h|--help|help|--version|version)
            return 1
            ;;
        new|register|upgrade|add-role|set-vcs-close-role|status|validate-models|stop)
            if [[ "\${2:-}" == "-h" || "\${2:-}" == "--help" ]]; then
                return 1
            fi
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

switchyard_user_can_prompt_for_sudo() {
    [[ -t 0 && -t 2 ]] || return 1
    id -nG 2>/dev/null | grep -Eq '(^| )(sudo|wheel|admin)( |$)'
}

switchyard_exec_with_root() {
    local command_display="switchyard"
    if [[ "\$#" -gt 0 ]]; then
        command_display+=" \$1"
    fi
    if "\$SWITCHYARD_SUDO_BIN" -n -v >/dev/null 2>&1; then
        exec "\$SWITCHYARD_SUDO_BIN" -n env PYTHONDONTWRITEBYTECODE="\$PYTHONDONTWRITEBYTECODE" "\$SWITCHYARD_TARGET" "\$@"
    fi
    if switchyard_user_can_prompt_for_sudo; then
        exec "\$SWITCHYARD_SUDO_BIN" env PYTHONDONTWRITEBYTECODE="\$PYTHONDONTWRITEBYTECODE" "\$SWITCHYARD_TARGET" "\$@"
    fi
    printf 'switchyard: command requires root: %s\n' "\$command_display" >&2
    printf 'switchyard: sudo is unavailable for this user or shell; run it as a sudo-capable human or ask an operator\n' >&2
    exit 1
}

if [[ "\${EUID:-\$(id -u)}" -ne 0 ]]; then
    case "\${1:-}" in
        -h|--help|help)
            switchyard_print_help
            exit 0
            ;;
        --version|version)
            switchyard_print_version
            exit 0
            ;;
    esac
    if switchyard_invocation_requires_root "\$@"; then
        switchyard_exec_with_root "\$@"
    fi
    if [[ ! -x "\$SWITCHYARD_TARGET" ]]; then
        switchyard_exec_with_root "\$@"
    fi
    exec "\$SWITCHYARD_TARGET" "\$@"
fi

if [[ ! -x "\$SWITCHYARD_TARGET" ]]; then
    printf 'switchyard: target is not executable: %s\n' "\$SWITCHYARD_TARGET" >&2
    exit 126
fi

exec "\$SWITCHYARD_TARGET" "\$@"
EOF
    chmod 0755 "$tmp"
    mv -f "$tmp" "$destination"
}

apply_install() {
    local install_dir
    install_dir="$(dirname "$INSTALL_PATH")"
    [[ -x "$SOURCE_PATH" ]] || die "source is not executable: $SOURCE_PATH"
    if [[ "$install_dir" == /usr || "$install_dir" == /usr/* || "${SWITCHYARD_FORCE_SECURE_PATH_CHECK:-}" == "1" ]]; then
        secure_path_contains_install_dir "$install_dir" || die "$install_dir is not in sudo secure_path"
    fi
    install -d -m 0755 "$install_dir"
    write_wrapper "$SOURCE_PATH" "$INSTALL_PATH"
    printf 'installed switchyard trampoline: %s -> %s\n' "$INSTALL_PATH" "$SOURCE_PATH"
}

print_commands() {
    local script_path
    script_path="$REPO_ROOT/scripts/install-switchyard"
    cat <<EOF
# Install switchyard on a PATH used by normal shells and sudo secure_path.
# This writes a tiny trampoline outside /home/agent; it does not copy launcher code, so self-deploy updates are picked up.
sudo env SWITCHYARD_SOURCE_PATH=$(quote "$SOURCE_PATH") SWITCHYARD_INSTALL_PATH=$(quote "$INSTALL_PATH") $(quote "$script_path") --apply

# Verify both the normal shell and sudo can resolve it.
command -v switchyard
sudo env sh -c 'command -v switchyard'
EOF
}

case "$mode" in
    apply)
        apply_install
        ;;
    print)
        print_commands
        ;;
esac
