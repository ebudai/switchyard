#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=0
ASSUME_MANAGER="${SWITCHYARD_PREREQS_ASSUME_MANAGER:-}"
SUDO_BIN="${SWITCHYARD_SUDO_BIN:-sudo}"
PYTHON_BIN="${SWITCHYARD_PYTHON_BIN:-python3}"
PIP_SPEC="psycopg>=3.3,<4"
SWITCHYARD_PYTHON_VENV="${SWITCHYARD_PYTHON_VENV:-/opt/switchyard/venv}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: scripts/install-switchyard-prereqs [--dry-run]

Installs Switchyard host packages with apt or pacman, installs psycopg, and
prints manual agent CLI install/authentication guidance.
EOF
}

die() {
    printf 'install-switchyard-prereqs: ERROR: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

detect_manager() {
    if [[ -n "$ASSUME_MANAGER" ]]; then
        case "$ASSUME_MANAGER" in
            apt|pacman) printf '%s\n' "$ASSUME_MANAGER" ;;
            *) die "unsupported SWITCHYARD_PREREQS_ASSUME_MANAGER: $ASSUME_MANAGER" ;;
        esac
        return
    fi
    if command -v apt-get >/dev/null 2>&1; then
        printf 'apt\n'
        return
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf 'pacman\n'
        return
    fi
    die "no supported package manager found; expected apt-get or pacman"
}

run_cmd() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
        return
    fi
    "$@"
}

manager="$(detect_manager)"
case "$manager" in
    apt)
        printf 'Refreshing apt package index with apt-get update before installing packages.\n'
        run_cmd "$SUDO_BIN" apt-get update
        run_cmd "$SUDO_BIN" apt-get install -y \
            python3 postgresql postgresql-client tmux git curl python3-venv python3-pil acl
        printf 'KDE/separate layout users also need Konsole: %s apt-get install -y konsole\n' "$SUDO_BIN"
        printf 'Installing psycopg into the shared Switchyard Python venv at %s.\n' "$SWITCHYARD_PYTHON_VENV"
        printf 'Using a system-site-packages venv avoids Debian/Ubuntu PEP 668 restrictions while keeping distro Pillow visible.\n'
        run_cmd "$SUDO_BIN" install -d -m 0755 "$(dirname "$SWITCHYARD_PYTHON_VENV")"
        run_cmd "$SUDO_BIN" "$PYTHON_BIN" -m venv --system-site-packages "$SWITCHYARD_PYTHON_VENV"
        run_cmd "$SUDO_BIN" "$SWITCHYARD_PYTHON_VENV/bin/python" -m pip install "$PIP_SPEC"
        printf 'Verifying the ticket board entry point imports under the shared Switchyard Python venv.\n'
        run_cmd "$SUDO_BIN" "$SWITCHYARD_PYTHON_VENV/bin/python" "$SCRIPT_DIR/ticket-board.py" --help
        ;;
    pacman)
        printf 'Not refreshing pacman package databases automatically; run %s pacman -Syu first on Arch-family systems.\n' "$SUDO_BIN"
        run_cmd "$SUDO_BIN" pacman -S --needed \
            python postgresql tmux git curl python-pip python-pillow acl
        printf 'KDE/separate layout users also need Konsole: %s pacman -S --needed konsole\n' "$SUDO_BIN"
        printf 'Installing psycopg for the invoking user with pip on Arch-family systems.\n'
        run_cmd "$PYTHON_BIN" -m pip install --user "$PIP_SPEC"
        ;;
esac

cat <<'EOF'

Agent CLI setup is manual; this script does not install agent CLIs.
Switchyard needs at least one installed and authenticated agent CLI before it can run panes.

Established vendor-documented Linux install methods:
- claude: curl -fsSL https://claude.ai/install.sh | bash
  Anthropic also publishes apt/dnf/apk repositories; the Debian/Ubuntu package is claude-code, not claude.
- codex: curl -fsSL https://chatgpt.com/codex/install.sh | sh
- agy: curl -fsSL https://antigravity.google/cli/install.sh | bash
- hermes: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash

See docs/fresh-machine-install.md for vendor documentation links. Before running any curl-piped installer,
you can fetch the script URL without piping it and read the script first.
After installing, open the CLI and authenticate at least one of: claude, codex, agy, or hermes.
Next step: run scripts/install-switchyard to print the privileged install block.
EOF
