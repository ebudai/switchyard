#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=0
ASSUME_MANAGER="${SWITCHYARD_PREREQS_ASSUME_MANAGER:-}"
SUDO_BIN="${SWITCHYARD_SUDO_BIN:-sudo}"
PYTHON_BIN="${SWITCHYARD_PYTHON_BIN:-python3}"
PIP_SPEC="psycopg>=3.3,<4"
SWITCHYARD_PYTHON_VENV="${SWITCHYARD_PYTHON_VENV:-/opt/switchyard/venv}"
# Matches ticket-board-service.sh: the shared venv when it is executable, /usr/bin/python3
# otherwise. Verification has to run under the interpreter the services will actually use,
# not merely under some python3 on PATH.
SWITCHYARD_SERVICE_FALLBACK_PYTHON="${SWITCHYARD_SERVICE_FALLBACK_PYTHON:-/usr/bin/python3}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: scripts/install-switchyard-prereqs [--dry-run]

Installs Switchyard host packages with apt or pacman and installs psycopg.
Agent CLIs are not installed by Switchyard; the user installs those.
EOF
}

die() {
    printf 'install-switchyard-prereqs: ERROR: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

detect_manager() {
    if [[ -n "$ASSUME_MANAGER" ]]; then
        case "$ASSUME_MANAGER" in
            apt|pacman) printf '%s\n' "$ASSUME_MANAGER" ;;
            *) die "unsupported SWITCHYARD_PREREQS_ASSUME_MANAGER: $ASSUME_MANAGER" ;;
        esac
        return
    fi
    if command -v apt-get >/dev/null 2>&1; then
        printf 'apt\n'
        return
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf 'pacman\n'
        return
    fi
    die "no supported package manager found; expected apt-get or pacman"
}

run_cmd() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
        return
    fi
    "$@"
}

service_python() {
    if [[ -x "$SWITCHYARD_PYTHON_VENV/bin/python" ]]; then
        printf '%s\n' "$SWITCHYARD_PYTHON_VENV/bin/python"
    else
        printf '%s\n' "$SWITCHYARD_SERVICE_FALLBACK_PYTHON"
    fi
}

is_root_context() {
    [[ "${EUID:-$(id -u)}" -eq 0 || "${SWITCHYARD_PREREQS_TEST_ASSUME_ROOT:-}" == "1" ]]
}

run_root_cmd() {
    if is_root_context && [[ -z "${SWITCHYARD_PREREQS_FORCE_SUDO_PREFIX:-}" ]]; then
        run_cmd "$@"
    else
        run_cmd "$SUDO_BIN" "$@"
    fi
}

manager="$(detect_manager)"
case "$manager" in
    apt)
        printf 'Refreshing apt package index with apt-get update before installing packages.\n'
        run_root_cmd apt-get update
        run_root_cmd apt-get install -y \
            python3 postgresql postgresql-client tmux git curl python3-venv python3-pil acl
        printf 'KDE/separate layout users also need Konsole: %s apt-get install -y konsole\n' "$SUDO_BIN"
        printf 'Installing psycopg into the shared Switchyard Python venv at %s.\n' "$SWITCHYARD_PYTHON_VENV"
        printf 'Using a system-site-packages venv avoids Debian/Ubuntu PEP 668 restrictions while keeping distro Pillow visible.\n'
        run_root_cmd install -d -m 0755 "$(dirname "$SWITCHYARD_PYTHON_VENV")"
        run_root_cmd "$PYTHON_BIN" -m venv --system-site-packages "$SWITCHYARD_PYTHON_VENV"
        run_root_cmd "$SWITCHYARD_PYTHON_VENV/bin/python" -m pip install "$PIP_SPEC"
        printf 'Verifying ticket board runtime dependencies under the shared Switchyard Python venv.\n'
        run_root_cmd "$SWITCHYARD_PYTHON_VENV/bin/python" -c "import psycopg, PIL; print(psycopg.__version__, PIL.__version__)"
        printf 'Verifying the ticket board entry point loads under the shared Switchyard Python venv.\n'
        run_root_cmd "$SWITCHYARD_PYTHON_VENV/bin/python" "$SCRIPT_DIR/ticket-board.py" --help
        ;;
    pacman)
        printf 'Not refreshing pacman package databases automatically; run %s pacman -Syu first on Arch-family systems.\n' "$SUDO_BIN"
        run_cmd "$SUDO_BIN" pacman -S --needed \
            python postgresql tmux git curl python-pillow python-psycopg acl
        printf 'KDE/separate layout users also need Konsole: %s pacman -S --needed konsole\n' "$SUDO_BIN"
        printf 'Installing psycopg from the distribution package python-psycopg, which satisfies %s.\n' "$PIP_SPEC"
        printf 'Arch-family Python is externally managed under PEP 668, so a user pip install is refused rather than merely discouraged.\n'
        verify_python="$(service_python)"
        printf 'Verifying ticket board runtime dependencies with %s, the interpreter generated services use.\n' "$verify_python"
        run_cmd "$verify_python" -c "import psycopg, PIL; print(psycopg.__version__, PIL.__version__)"
        printf 'Verifying the ticket board entry point loads with %s.\n' "$verify_python"
        run_cmd "$verify_python" "$SCRIPT_DIR/ticket-board.py" --help
        ;;
esac
