#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=0
ASSUME_MANAGER="${SWITCHYARD_PREREQS_ASSUME_MANAGER:-}"
SUDO_BIN="${SWITCHYARD_SUDO_BIN:-sudo}"
PYTHON_BIN="${SWITCHYARD_PYTHON_BIN:-python3}"
PIP_SPEC="psycopg>=3.3,<4"
SWITCHYARD_PYTHON_VENV="${SWITCHYARD_PYTHON_VENV:-/opt/switchyard/venv}"
# Matches ticket-board-service.sh: the shared venv when it is executable, /usr/bin/python3
# otherwise. Verification has to run under the interpreter the services will actually use,
# not merely under some python3 on PATH.
SWITCHYARD_SERVICE_FALLBACK_PYTHON="${SWITCHYARD_SERVICE_FALLBACK_PYTHON:-/usr/bin/python3}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: scripts/install-switchyard-prereqs [--dry-run]

Installs Switchyard host packages with apt or pacman and installs psycopg.
Agent CLIs are not installed by Switchyard; the user installs those.
EOF
}

die() {
    printf 'install-switchyard-prereqs: ERROR: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

detect_manager() {
    if [[ -n "$ASSUME_MANAGER" ]]; then
        case "$ASSUME_MANAGER" in
            apt|pacman) printf '%s\n' "$ASSUME_MANAGER" ;;
            *) die "unsupported SWITCHYARD_PREREQS_ASSUME_MANAGER: $ASSUME_MANAGER" ;;
        esac
        return
    fi
    if command -v apt-get >/dev/null 2>&1; then
        printf 'apt\n'
        return
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf 'pacman\n'
        return
    fi
    die "no supported package manager found; expected apt-get or pacman"
}

run_cmd() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
        return
    fi
    "$@"
}

service_python() {
    if [[ -x "$SWITCHYARD_PYTHON_VENV/bin/python" ]]; then
        printf '%s\n' "$SWITCHYARD_PYTHON_VENV/bin/python"
    else
        printf '%s\n' "$SWITCHYARD_SERVICE_FALLBACK_PYTHON"
    fi
}

is_root_context() {
    [[ "${EUID:-$(id -u)}" -eq 0 || "${SWITCHYARD_PREREQS_TEST_ASSUME_ROOT:-}" == "1" ]]
}

run_root_cmd() {
    if is_root_context && [[ -z "${SWITCHYARD_PREREQS_FORCE_SUDO_PREFIX:-}" ]]; then
        run_cmd "$@"
    else
        run_cmd "$SUDO_BIN" "$@"
    fi
}

#: Prove the ticket board entry point imports and builds its argument surface,
#: without printing that surface. `--help` is what an operator gets when they
#: ask for it; printing 29 lines of argparse in the middle of a privileged
#: install transcript made a healthy install read as a command rejected for a
#: wrong parameter, and buried the diagnostics either side of it (SYRD-215).
#:
#: The probe itself is unchanged, so what is proved is unchanged: the failure
#: path prints exactly what the entry point said and stops.
verify_ticket_board_entry_point() {
    local python="$1"
    local privileged="${2:-0}"
    local -a command=("$python" "$SCRIPT_DIR/ticket-board.py" --help)
    # The same privilege this probe always ran with, and the same printed line:
    # only what it does with the OUTPUT changes.
    if [[ "$privileged" == "1" ]] && ! { is_root_context && [[ -z "${SWITCHYARD_PREREQS_FORCE_SUDO_PREFIX:-}" ]]; }; then
        command=("$SUDO_BIN" "${command[@]}")
    fi
    local output status=0
    printf '+'
    printf ' %q' "${command[@]}"
    printf '\n'
    if [[ "$DRY_RUN" -eq 1 ]]; then
        return 0
    fi
    output="$("${command[@]}" 2>&1)" || status=$?
    if (( status != 0 )); then
        printf '%s\n' "$output" >&2
        die "the ticket board entry point did not load with $python (exit $status); the error above is its own"
    fi
    printf 'Ticket board entry point loads with %s.\n' "$python"
}

#: The package managers install a PostgreSQL server; only one of them leaves a
#: cluster behind. This runs in both branches so a fresh host is either ready
#: for `switchyard new` or stopped here with the procedure, rather than at the
#: database preflight after every provisioning answer has been collected
#: (SYRD-235).
ensure_postgres_cluster() {
    local -a args=()
    if [[ "$DRY_RUN" -eq 1 ]]; then
        args+=(--dry-run)
    fi
    printf 'Ensuring the local PostgreSQL cluster serves the socket switchyard new connects to.\n'
    if ! "$SCRIPT_DIR/ensure-postgres-cluster" "${args[@]}"; then
        die "PostgreSQL is not ready for switchyard new. Run the procedure above, then re-run this installer; both are idempotent."
    fi
}

# polkit is a runtime dependency, not a desktop nicety: provisioning installs a
# rule under /etc/polkit-1/rules.d so the project account can restart its own
# board, and the privileged entry points go through pkexec. A desktop host
# always has it; a minimal one does not, and `switchyard new` then failed
# halfway through its packet with the tenant stranded (SYRD-261).
#
# Debian 12+ and Ubuntu 22.10+ split it into polkitd and pkexec; older
# releases ship both in policykit-1 and have no package by the new names, so
# naming those there would abort the whole install. Ask the archive.
apt_polkit_packages() {
    if apt-cache show --no-all-versions pkexec >/dev/null 2>&1; then
        printf 'polkitd pkexec\n'
    else
        printf 'policykit-1\n'
    fi
}

manager="$(detect_manager)"
case "$manager" in
    apt)
        printf 'Refreshing apt package index with apt-get update before installing packages.\n'
        run_root_cmd apt-get update
        # shellcheck disable=SC2046 # one package name per word, on purpose
        run_root_cmd apt-get install -y \
            python3 postgresql postgresql-client tmux git curl python3-venv python3-pil acl $(apt_polkit_packages)
        printf 'KDE/separate layout users also need Konsole: %s apt-get install -y konsole\n' "$SUDO_BIN"
        ensure_postgres_cluster
        printf 'Installing psycopg into the shared Switchyard Python venv at %s.\n' "$SWITCHYARD_PYTHON_VENV"
        printf 'Using a system-site-packages venv avoids Debian/Ubuntu PEP 668 restrictions while keeping distro Pillow visible.\n'
        run_root_cmd install -d -m 0755 "$(dirname "$SWITCHYARD_PYTHON_VENV")"
        run_root_cmd "$PYTHON_BIN" -m venv --system-site-packages "$SWITCHYARD_PYTHON_VENV"
        run_root_cmd "$SWITCHYARD_PYTHON_VENV/bin/python" -m pip install "$PIP_SPEC"
        printf 'Verifying ticket board runtime dependencies under the shared Switchyard Python venv.\n'
        run_root_cmd "$SWITCHYARD_PYTHON_VENV/bin/python" -c "import psycopg, PIL; print(psycopg.__version__, PIL.__version__)"
        printf 'Verifying the ticket board entry point loads under the shared Switchyard Python venv.\n'
        verify_ticket_board_entry_point "$SWITCHYARD_PYTHON_VENV/bin/python" 1
        ;;
    pacman)
        printf 'Not refreshing pacman package databases automatically; run %s pacman -Syu first on Arch-family systems.\n' "$SUDO_BIN"
        run_cmd "$SUDO_BIN" pacman -S --needed \
            python postgresql tmux git curl python-pillow python-psycopg acl polkit
        printf 'KDE/separate layout users also need Konsole: %s pacman -S --needed konsole\n' "$SUDO_BIN"
        ensure_postgres_cluster
        printf 'Installing psycopg from the distribution package python-psycopg, which satisfies %s.\n' "$PIP_SPEC"
        printf 'Arch-family Python is externally managed under PEP 668, so a user pip install is refused rather than merely discouraged.\n'
        verify_python="$(service_python)"
        printf 'Verifying ticket board runtime dependencies with %s, the interpreter generated services use.\n' "$verify_python"
        run_cmd "$verify_python" -c "import psycopg, PIL; print(psycopg.__version__, PIL.__version__)"
        printf 'Verifying the ticket board entry point loads with %s.\n' "$verify_python"
        verify_ticket_board_entry_point "$verify_python"
        ;;
esac
