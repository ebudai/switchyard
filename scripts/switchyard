#!/usr/bin/env python3
"""Switchyard project entrypoint."""

from __future__ import annotations

import sys
from pathlib import Path

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

if __name__ == "__main__" and sys.argv[1:2] == ["job-selftest"]:
    # SYRD-113: the catalogued job-selftest action's operation. It reads and
    # changes nothing, so it runs before the launcher or anything else is imported.
    from scripts.ticket_board.privileged_selftest import main as job_selftest

    raise SystemExit(job_selftest(sys.argv[2:]))

if __name__ == "__main__" and sys.argv[1:2] == ["conversation-adoption-record"]:
    # SYRD-694: the catalogued adopt-conversation actions' operation, root's own record. It reads no tenant file,
    # so it runs before the launcher or anything else is imported.
    from scripts.conversation_adoption_record import main as conversation_adoption_record

    raise SystemExit(conversation_adoption_record(sys.argv[2:]))

from scripts.team_launcher import switchyard_main
from scripts.repository_hooks import install_new_registry_entries, registry_snapshot


if __name__ == "__main__":
    arguments = sys.argv[1:]
    new_project = bool(
        arguments
        and arguments[0] == "new"
        and not any(value in {"-h", "--help", "--no-git-init"} for value in arguments[1:])
    )
    registry_before = registry_snapshot(arguments) if new_project else frozenset()
    result = switchyard_main(arguments)
    if result == 0 and new_project:
        for installed_hook in install_new_registry_entries(arguments, registry_before, source_root=ROOT):
            print(f"switchyard: installed repository policy {installed_hook}")
    raise SystemExit(result)
