#!/usr/bin/env python3
"""Deployed-tree entry point for the board skill installer.

`switchyard board-skill ...` is the supported public command; this script is the
same implementation, reachable directly from a deployed tree's `scripts/`
directory for provisioning and launch.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from board_skill_cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:], prog="switchyard-board-skill"))
