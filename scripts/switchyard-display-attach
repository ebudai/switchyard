#!/usr/bin/env python3
"""Attach one terminal tab to one of a tenant's display sessions.

The presentation window belongs to a person's desktop; the display sessions
belong to the tenant's owner account. Something has to cross that line once per
tab, and the two obvious ways are both wrong: `sudo -u <owner> tmux attach` in
six tabs asks a human for their password six times as a window opens, and a
blanket sudo grant on the owner account hands over every command the owner
could ever run.

This is the narrow alternative, and it is deliberately the same shape as
switchyard-tenant-control:

* WHO. The caller is SUDO_UID, which the kernel sets and the caller cannot
  choose, checked against the authorized user in this tenant's root-owned
  grant file.
* WHAT. One slot number, and nothing else on the command line. No session
  name, no tmux argument, no command to run inside it -- the session name is
  built here from the pinned project and the validated slot, so this cannot be
  aimed at a worker session, at another tenant's session, or at a shell.
* WHERE. The project, its owner and the grant all come from root-owned data.
* HOW. The environment is rebuilt rather than inherited, minus TMUX, so an
  attach from inside another tmux client cannot nest by accident.
* WHAT THE CLIENT MAY THEN DO. Choosing the session is not the whole of it.
  An attached tmux client inherits that session's key tables, so with the
  owner's default prefix live this grant would hand a desktop user prefix-c
  for a shell in the owner's account, prefix-colon for a tmux command prompt,
  and prefix-s to reach every other session on that server -- another
  project's included, where two share an owner. So the transport is locked
  before the attach: both prefixes are removed and the session is pointed at a
  key table with no bindings in it, which also takes away any `bind -n` the
  owner's own tmux.conf may carry. Every key then falls through to the pane,
  which is the proxy attached to the worker, so ordinary typing still reaches
  the role and no keystroke reaches tmux. The lock is applied here rather than
  trusted from whatever configured the slot: this program is the boundary, and
  a session made by an older release would otherwise still be open.

It attaches to an existing session and never creates one: a slot that is not
there is a presentation that has not been bootstrapped, and quietly creating an
empty session in the owner's server would hide that.
"""

from __future__ import annotations

import json
import os
import pwd
import re
import stat
import subprocess
import sys
from pathlib import Path
from typing import NoReturn

PROJECT_SLUG = re.compile(r"^[a-z0-9][a-z0-9_]{0,39}$")
#: A key table that is never given any bindings, so every lookup in it misses
#: and the key is passed to the pane instead of being acted on by tmux.
DISPLAY_KEY_TABLE = "switchyard-display"
#: What makes an attached client input-only. Kept beside the attach it guards.
LOCK_OPTIONS = (("prefix", "None"), ("prefix2", "None"), ("key-table", DISPLAY_KEY_TABLE))
GRANT_ROOT = Path("/usr/local/lib/switchyard")
GRANT_NAME = "control-grant.json"
PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
TMUX = "/usr/bin/tmux"
#: Matches the launcher's own ceiling on a single presentation window.
MAX_SLOTS = 6


def fail(message: str) -> NoReturn:
    raise SystemExit(f"switchyard-display-attach: {message}")


def calling_user() -> str:
    """The invoking account, resolved from the id sudo got from the kernel."""
    raw = (os.environ.get("SUDO_UID") or "").strip()
    if not raw.isdigit():
        fail("must be run through the tenant display sudo grant")
    try:
        return pwd.getpwuid(int(raw)).pw_name
    except KeyError:
        fail("the calling account no longer exists")


def load_grant(project: str) -> dict[str, str]:
    path = GRANT_ROOT / project / GRANT_NAME
    try:
        raw = path.read_text(encoding="utf-8")
        info = path.stat()
    except FileNotFoundError:
        fail(f"no control grant is installed for {project}")
    except OSError as exc:
        fail(f"cannot read the control grant for {project}: {exc}")
    if info.st_uid != 0:
        fail(f"the control grant for {project} is not root-owned")
    if info.st_mode & 0o022:
        fail(f"the control grant for {project} is writable by non-root")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"the control grant for {project} is unreadable: {exc}")
    if not isinstance(payload, dict):
        fail(f"the control grant for {project} is not an object")
    missing = [key for key in ("project", "owner", "authorized_user") if not payload.get(key)]
    if missing:
        fail(f"the control grant for {project} is missing {', '.join(missing)}")
    if payload["project"] != project:
        fail("the control grant names a different project")
    return {key: str(value) for key, value in payload.items()}


def session_name(project: str, slot: int) -> str:
    return f"{project}-display-{slot}"


def lock_argv(session: str) -> list[str]:
    """One tmux invocation that removes every way this client could act.

    Also proves the session is already there: set-option refuses a session that
    does not exist, and attaching to a slot that was never bootstrapped should
    say so rather than sit on a blank terminal.
    """
    argv = ["tmux"]
    for index, (option, value) in enumerate(LOCK_OPTIONS):
        if index:
            argv.append(";")
        # The trailing colon makes this a session target, which is what
        # exact-name selection needs in order to apply at all.
        argv.extend(["set-option", "-t", f"={session}:", option, value])
    return argv


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        fail("usage: switchyard-display-attach <project> <slot>")
    project, raw_slot = argv
    if not PROJECT_SLUG.fullmatch(project):
        fail("project must be a plain slug")
    if not raw_slot.isdigit():
        fail("slot must be a number")
    slot = int(raw_slot)
    if slot >= MAX_SLOTS:
        fail(f"slot must be within 0..{MAX_SLOTS - 1}")

    grant = load_grant(project)
    caller = calling_user()
    if caller != grant["authorized_user"]:
        fail(f"{caller} may not display {project}; it is registered to {grant['authorized_user']}")

    owner = grant["owner"]
    try:
        owner_entry = pwd.getpwnam(owner)
    except KeyError:
        fail(f"the owner account {owner} for {project} does not exist")

    if os.geteuid() != 0:
        fail("must run as root through the tenant display sudo grant")
    try:
        info = os.stat(TMUX)
    except OSError as exc:
        fail(f"{TMUX} is unavailable: {exc}")
    if info.st_uid != 0 or info.st_mode & 0o022 or not stat.S_ISREG(info.st_mode):
        fail(f"{TMUX} is not a root-controlled regular file")

    environ = {
        "PATH": PATH,
        "HOME": owner_entry.pw_dir,
        "USER": owner,
        "LOGNAME": owner,
        "SHELL": "/bin/sh",
        "LANG": "C.UTF-8",
        # The tab's own terminal type is the one thing the display needs from
        # the caller, and it is not a path to anything.
        "TERM": os.environ.get("TERM", "xterm-256color"),
    }
    # Exact-name selection: a prefix match could reach a longer session name in
    # the same server, which is another role's.
    session = session_name(project, slot)
    command = [TMUX, "attach", "-t", f"={session}"]

    os.setgroups([])
    os.initgroups(owner, owner_entry.pw_gid)
    os.setgid(owner_entry.pw_gid)
    os.setuid(owner_entry.pw_uid)
    if os.geteuid() != owner_entry.pw_uid or os.getuid() != owner_entry.pw_uid:
        fail("could not drop to the owner account")

    # Locked as the owner, before any client exists. A lock that cannot be
    # applied is a refusal: attaching anyway would hand over the owner's whole
    # tmux server, which is the thing this program exists not to do.
    lock = lock_argv(session)
    result = subprocess.run(
        [TMUX, *lock[1:]], env=environ, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True
    )
    if result.returncode != 0:
        reason = (result.stderr or "").strip() or f"tmux exited {result.returncode}"
        fail(f"cannot secure display slot {slot} of {project}: {reason}")
    os.execve(command[0], command, environ)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
