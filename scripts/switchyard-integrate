#!/usr/bin/env python3
"""Prepare one integration and hand it to the privileged operation.

The control role prepares a merge the way it always has, in its own checkout,
with its own git identity. What it cannot do any more is push it: the shared
account's credential is read-only, which is the point of the cutover. So this
bundles the prepared commit, states the exact tip it was prepared against, and
runs the root-owned integration program, which decides for itself whether the
process asking is the registered controller (SYRD-93).

Nothing here is privileged and nothing here holds a credential. Getting the tip
wrong, or preparing against a stale one, produces a refusal rather than a
surprise: the privileged program re-reads the remote itself and compares.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import NoReturn

PRIVILEGED_ROOT = "/usr/local/lib/switchyard"
OUTBOX = ".local/state/switchyard/publish-outbox"


def fail(message: str) -> NoReturn:
    raise SystemExit(f"switchyard-integrate: {message}")


def git(args: list[str], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", "-C", str(cwd), *args], text=True, capture_output=True)


def require(result: subprocess.CompletedProcess[str], what: str) -> str:
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        fail(what)
    return result.stdout.strip()


def remote_tip(repository: Path, remote: str, ref: str) -> str:
    listed = require(
        git(["ls-remote", remote, f"refs/heads/{ref}"], cwd=repository),
        f"cannot read {ref} from {remote}",
    )
    for line in listed.splitlines():
        commit, _, name = line.partition("\t")
        if name.strip() == f"refs/heads/{ref}":
            return commit.strip()
    fail(f"{remote} has no {ref} to integrate into")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="switchyard-integrate")
    parser.add_argument("commit", nargs="?", default="HEAD", help="the prepared commit")
    parser.add_argument("--project", default=os.environ.get("TICKET_BOARD_PROJECT", "").strip())
    parser.add_argument("--repository", default="", help="checkout holding the prepared commit")
    parser.add_argument("--remote", default="origin")
    parser.add_argument("--ref", default="main", help="the integration branch to read the tip of")
    parser.add_argument("--integrator", default="", help="override the privileged program path")
    parser.add_argument("--sudo", default="sudo", help="how to reach the privileged program")
    parser.add_argument("--print-only", action="store_true", help="prepare the bundle, run nothing")
    args = parser.parse_args(argv[1:])

    if not args.project:
        fail("no project: run this from a role pane, or pass --project")
    repository = Path(args.repository).expanduser() if args.repository else Path.cwd()
    if not (repository / ".git").exists():
        fail(f"{repository} is not a git worktree")

    commit = require(
        git(["rev-parse", f"{args.commit}^{{commit}}"], cwd=repository),
        f"{args.commit} does not resolve to a commit in {repository}",
    )
    tip = remote_tip(repository, args.remote, args.ref)
    if commit == tip:
        print(f"switchyard-integrate: {args.ref} is already at {commit[:12]}; nothing to integrate")
        return 0
    # Checked here so the answer is immediate and local; the privileged program
    # checks it again against the remote it is pinned to, which is the one that
    # counts.
    if git(["merge-base", "--is-ancestor", tip, commit], cwd=repository).returncode != 0:
        fail(
            f"{commit[:12]} is not a descendant of {args.ref} at {tip[:12]}. Integration is "
            "fast-forward only: merge the current tip into your candidate and try again"
        )

    outbox = Path.home() / OUTBOX / args.project
    outbox.mkdir(parents=True, exist_ok=True)
    outbox.chmod(0o755)
    bundle = outbox / f"integration-{commit[:12]}.bundle"
    branch = f"switchyard-integration/{commit[:12]}"
    require(git(["branch", "--force", branch, commit], cwd=repository), f"could not name {commit}")
    require(git(["bundle", "create", str(bundle), branch], cwd=repository), "could not bundle it")
    bundle.chmod(0o644)

    integrator = args.integrator or f"{PRIVILEGED_ROOT}/{args.project}/switchyard-integrate-main"
    command = [
        *([args.sudo, "-n"] if args.sudo else []),
        integrator,
        "--project", args.project,
        "--expected", tip,
        "--commit", commit,
        "--bundle", str(bundle),
    ]
    if args.print_only:
        print(json.dumps({"expected": tip, "commit": commit, "bundle": str(bundle),
                          "command": command}, sort_keys=True))
        return 0

    print(f"switchyard-integrate: {args.ref} {tip[:12]} -> {commit[:12]}")
    integrated = subprocess.run(command, text=True, capture_output=True)
    sys.stdout.write(integrated.stdout)
    sys.stderr.write(integrated.stderr)
    if integrated.returncode != 0:
        fail(
            f"the integration was refused or failed; {args.ref} was not moved by this run. The "
            f"prepared commit and its bundle are still here: {bundle}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
