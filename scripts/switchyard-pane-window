#!/bin/sh
# One presentation pane's terminal program. SYRD-43.
#
# Konsole runs this as the tab's program instead of running the attach command
# from an interactive shell. When the tmux client detaches, exits or fails, the
# tab must not fall back to a prompt: whatever shell Konsole would return to is
# the shell that started the window, and a window started by a privileged
# invocation would return to a root prompt that anything pasted into the tab
# would then run.
#
# There is deliberately no shell here after the client. The pane says why it
# ended and then waits, inert, until the tab is closed or the project is
# relaunched. Typed and pasted input reach nothing.
#
# The pane also names itself. Konsole's layout file has no key for a split's
# title -- its parser reads Widgets, Orientation, Command, WorkingDirectory,
# Lines, Columns and SessionRestoreId, and nothing else -- so a title written
# there is silently dropped and every header falls back to the profile's
# default `%d : %n`, which is the generic cwd-and-program text the presentation
# was showing. The escape below is how a Konsole split is named from inside it
# (SYRD-122).
#
# It names two different things, through two different escapes, because Konsole
# tells them apart and a person reads them in two different places. OSC 30 sets
# this split's own title: the text in its header, and nothing else's. OSC 2 sets
# what Konsole calls the window title -- the one an escape sequence sets -- and
# with `ShowWindowTitleOnTitleBar` every split reporting the same project name
# leaves the window reading that name whichever split has focus. Putting the
# project into the split titles instead got the window right only by repeating
# the project in six headers, and the window still changed as focus moved
# (SYRD-139).
set -u

title=""
window_title=""
while [ "$#" -ge 2 ]; do
    case "$1" in
        --title) title="$2"; shift 2 ;;
        --window-title) window_title="$2"; shift 2 ;;
        *) break ;;
    esac
done

if [ "$#" -eq 0 ]; then
    printf 'switchyard: switchyard-pane-window needs the pane command to run\n' >&2
    exit 2
fi

if [ -n "$window_title" ]; then
    # The window's name, reported identically by every split, so the title bar
    # reads the project rather than whichever pane was clicked last.
    printf '\033]2;%s\007' "$window_title"
fi

if [ -n "$title" ]; then
    # Konsole reads this as the tab title format for this split, and a format
    # with no placeholders in it is literal text: it does not follow the
    # working directory or the program, so it stays put while the CLI works.
    printf '\033]30;%s\007' "$title"
fi

"$@"
status=$?

printf '\n'
if [ "$status" -eq 0 ]; then
    printf 'switchyard: this pane detached. It is inert -- close the tab, or relaunch the\n'
else
    printf 'switchyard: this pane exited with status %s. It is inert -- close the tab, or relaunch the\n' "$status"
fi
printf 'project to reattach. Nothing typed or pasted here runs anywhere.\n'

# exec so no shell remains in this process at all.
exec sleep infinity
