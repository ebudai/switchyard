#!/usr/bin/env python3
"""Install ONE agent CLI the operator already has, host-wide, as root.

SYRD-211. SYRD-210 promoted a caller-local executable to a root-owned host-wide
copy, and did it with a plain `chown(path, 0, 0)` from inside the running
process. That worked only because its one caller, `switchyard new`, already runs
as root. A resumed tenant is launched by `switchyard <project>`, which is
deliberately unprivileged, so the same call fails with EPERM and the operator
cannot accept the offer at all.

This is the elevation boundary for that one action, and nothing else:

* WHO. The operator is resolved from SUDO_UID through the account database, not
  from SUDO_USER, which is a string the caller's environment can carry. A system
  account may not use this.
* WHAT. One CLI from a fixed list, named here rather than taken from the
  unprivileged side. A privileged program validates its own arguments.
* WHICH FILE. Validated on the OPEN DESCRIPTOR, not on the path, so the file
  checked is the file copied. It must be a regular executable belonging to the
  operator or to root, and not writable by anyone else.
* WHERE. A fixed destination. The caller does not choose it, which is what keeps
  this from being a root file-copy primitive.
* AFTERWARDS. The promoted binary is verified by RUNNING it, so it is never run
  as root: privileges are dropped to the tenant owner for that, in a clean
  tenant-equivalent environment, and only then is anything replaced.
* THE RECORD. This program does not write one. It is RUN BY
  `switchyard-record-rollout`, which opens the journal attempt before this
  starts and captures whatever this prints and returns. A mutation that could
  not be journalled therefore never begins, instead of being recorded as an
  afterthought that may quietly not happen at all (SYRD-211 DAT rejection 4).

Deliberately standalone. It imports nothing from the launcher: a boundary that
trusts the unprivileged side's tables to decide what the privileged side may do
is not a boundary.
"""

from __future__ import annotations

import os
import pwd
import json
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn

PROGRAM = "switchyard-promote-agent-cli"

#: The CLIs this may install. Its own copy on purpose -- see the module note.
PROMOTABLE_CLIS = ("agy", "claude", "codex", "hermes")

#: Not chosen by the caller, and deliberately one of the entries below: a
#: promoted copy has to land somewhere every pane already looks. These two move
#: together or not at all.
DESTINATION_DIR = Path("/usr/local/bin")

#: The PATH every pane is given, and the environment the candidate is verified
#: in. Contains DESTINATION_DIR above.
PANE_BASE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

#: Below this, an account is a system account rather than a person.
MINIMUM_OPERATOR_UID = 1000

#: Root-owned tenant data. The verification identity is taken from here, never
#: from the caller: proving a binary runs for the operator proves only "not
#: root", and the operator can read their own home and their own groups while
#: the tenant owner cannot (SYRD-211 DAT rejection 2).
GRANT_ROOT = Path("/usr/local/lib/switchyard")
GRANT_NAME = "control-grant.json"

#: When no tenant is named, verification runs as a deliberately isolated
#: account instead -- one with no home worth reading and no supplementary
#: groups. Never the operator.
ISOLATED_VERIFIER = "nobody"

PROJECT_SLUG = re.compile(r"^[a-z0-9][a-z0-9_]{0,39}$")

CLI_NAME = re.compile(r"^[a-z][a-z0-9-]{0,31}$")


def fail(message: str) -> NoReturn:
    raise SystemExit(f"{PROGRAM}: {message}")


def calling_operator() -> pwd.struct_passwd:
    """The human behind this sudo, from the id the kernel gave sudo to resolve.

    SUDO_USER is copied from the environment sudo was handed; SUDO_UID is the
    numeric id sudo itself resolved. Taking the name from the id means a caller
    cannot present somebody else's name (the tenant control bridge resolves its
    caller the same way, SYRD-50).
    """
    raw = os.environ.get("SUDO_UID", "").strip()
    if not raw.isdigit():
        fail("run this through sudo; the invoking operator could not be identified")
    uid = int(raw)
    if uid < MINIMUM_OPERATOR_UID:
        fail(f"uid {uid} is a system account; only a real operator may promote a CLI")
    try:
        return pwd.getpwuid(uid)
    except KeyError:
        fail(f"uid {uid} has no account; refusing to promote on its behalf")


def verification_identity(
    project: str, operator: pwd.struct_passwd
) -> tuple[pwd.struct_passwd, str]:
    """Who the promoted binary is proved to work for, and why that is not you.

    With a tenant named, the answer comes from that tenant's root-owned grant:
    the same file the lifecycle bridge trusts, read by root, naming the owner
    account the panes actually run as. The operator does not get to assert it,
    and the grant must agree that this operator is the one authorised to drive
    that tenant -- otherwise anyone with a sudo rule could have root verify
    against somebody else's account.

    With no tenant named, verification falls back to an isolated account rather
    than to the operator, because the operator is exactly the identity whose
    private files would make a broken binary look fine.
    """
    if not project:
        try:
            return pwd.getpwnam(ISOLATED_VERIFIER), f"isolated account {ISOLATED_VERIFIER}"
        except KeyError:
            fail(
                f"no tenant was named and there is no {ISOLATED_VERIFIER} account to verify as; "
                "nothing has been installed"
            )
    if not PROJECT_SLUG.match(project):
        fail(f"{project!r} is not a project slug")
    grant_file = GRANT_ROOT / project / GRANT_NAME
    try:
        info = grant_file.lstat()
    except OSError as exc:
        fail(f"cannot read the tenant grant for {project}: {exc}")
    if not stat.S_ISREG(info.st_mode):
        fail(f"{grant_file} is not a regular file")
    if info.st_uid != 0 or info.st_mode & 0o022:
        fail(
            f"{grant_file} is not root-owned and unwritable by others; refusing to take a "
            "verification identity from it"
        )
    try:
        payload = json.loads(grant_file.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"cannot parse the tenant grant for {project}: {exc}")
    if not isinstance(payload, dict) or str(payload.get("project") or "") != project:
        fail(f"the grant at {grant_file} does not name {project}")
    authorized = str(payload.get("authorized_user") or "")
    if authorized != operator.pw_name:
        fail(
            f"{operator.pw_name} is not the operator registered to control {project} "
            f"({authorized or 'nobody'} is); refusing to verify against its owner"
        )
    owner = str(payload.get("owner") or "")
    if not owner:
        fail(f"the grant at {grant_file} records no owner account")
    if owner == operator.pw_name:
        fail(
            f"the grant for {project} names {owner} as both operator and owner; a tenant-equivalent "
            "verification needs an account that is not the operator"
        )
    try:
        return pwd.getpwnam(owner), f"tenant owner {owner} of {project}"
    except KeyError:
        fail(f"the owner account {owner} for {project} does not exist")


def validated_cli(name: str) -> str:
    if not CLI_NAME.match(name):
        fail(f"{name!r} is not a CLI name")
    if name not in PROMOTABLE_CLIS:
        fail(f"{name} is not one of {', '.join(PROMOTABLE_CLIS)}")
    return name


def _resume_root(saved_groups: list[int]) -> None:
    """Back to root. euid first, because only root may change the rest."""
    os.seteuid(0)
    os.setegid(0)
    try:
        os.setgroups(saved_groups)
    except OSError:  # pragma: no cover - we only ever shrink and restore
        pass


def opened_source(cli: str, offered: str, operator: pwd.struct_passwd) -> int:
    """Open it with the OPERATOR's authority, then check the descriptor.

    Root opening a path the caller named is a confused deputy: the caller picks
    the path, root supplies the authority, and the bytes come out somewhere the
    caller can read. A root-owned mode-0700 script that answers `--version` was
    promoted into a world-readable /usr/local/bin/<cli> exactly that way, which
    disclosed its contents to every account on the host (SYRD-211 DAT
    rejection 3).

    So the open happens under the operator's own uid, gid and supplementary
    groups -- their real filesystem authority, not an approximation of it. A
    file they cannot read is refused here, before root has read a byte of it.

    Everything after the open is checked with `fstat` on the descriptor that
    open returned, so the race protection is unchanged: the file validated is
    the file copied, whoever renames what afterwards.
    """
    if not Path(offered).is_absolute():
        fail(f"{offered} is not an absolute path")
    try:
        groups = os.getgrouplist(operator.pw_name, operator.pw_gid)
    except (KeyError, OSError):
        groups = [operator.pw_gid]
    saved_groups = os.getgroups()
    try:
        os.setgroups(groups)
        os.setegid(operator.pw_gid)
        os.seteuid(operator.pw_uid)
    except OSError as exc:
        _resume_root(saved_groups)
        fail(f"could not take {operator.pw_name}'s authority to read {offered}: {exc}")
    try:
        fd = os.open(offered, os.O_RDONLY)
    except OSError as exc:
        _resume_root(saved_groups)
        fail(
            f"{operator.pw_name} cannot read {offered}: {exc}. Refusing to open it as root: "
            f"promoting it would publish its contents in a world-readable {DESTINATION_DIR}/{cli}"
        )
    finally:
        _resume_root(saved_groups)
    try:
        info = os.fstat(fd)
    except OSError as exc:
        os.close(fd)
        fail(f"cannot inspect {offered}: {exc}")
    problems: list[str] = []
    if not stat.S_ISREG(info.st_mode):
        problems.append("is not a regular file")
    if not info.st_mode & 0o111:
        problems.append("is not executable")
    if info.st_uid not in (0, operator.pw_uid):
        problems.append(
            f"belongs to uid {info.st_uid}, neither root nor {operator.pw_name}"
        )
    if info.st_mode & 0o022:
        problems.append(
            f"is group- or world-writable (mode {stat.S_IMODE(info.st_mode):04o}), so "
            "somebody else chooses what would be installed"
        )
    if problems:
        os.close(fd)
        fail(f"refusing to promote {cli} from {offered}: it " + "; it ".join(problems))
    return fd


def stage_candidate(fd: int, cli: str) -> Path:
    """Write the candidate beside its destination, root-owned -- and stop there.

    Nothing is replaced yet. The previous host-wide copy, if there is one, is
    still the one every tenant runs, and stays that way until this candidate has
    proved it works. Verifying after `os.replace` destroyed a good binary
    whenever the new one turned out to be broken, while the caller reported that
    nothing had changed (SYRD-211 DAT rejection 1).
    """
    try:
        DESTINATION_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(f"cannot prepare {DESTINATION_DIR}: {exc}")
    staged_fd, staged_name = tempfile.mkstemp(
        dir=str(DESTINATION_DIR), prefix=f".{cli}.promote."
    )
    staged = Path(staged_name)
    try:
        with os.fdopen(staged_fd, "wb") as target:
            os.lseek(fd, 0, os.SEEK_SET)
            with os.fdopen(os.dup(fd), "rb") as source:
                shutil.copyfileobj(source, target)
            target.flush()
            os.fsync(target.fileno())
            # Explicit, not inherited: a setgid destination directory would
            # otherwise hand the promoted file somebody else's group.
            os.fchmod(target.fileno(), 0o755)
            os.fchown(target.fileno(), 0, 0)
    except OSError as exc:
        discard(staged)
        fail(f"could not stage {cli} in {DESTINATION_DIR}: {exc}")
    return staged


def discard(path: Path) -> None:
    """Leave nothing behind. Called on every failure path, including replace."""
    try:
        path.unlink()
    except OSError:
        pass


def commit_candidate(staged: Path, cli: str) -> Path:
    """One atomic rename, and it is the last thing that happens.

    Everything that can refuse already has: the source, the staged copy's
    ownership and mode, the candidate actually running for the tenant, and the
    destination being somewhere panes look. So a tenant launching during this
    sees the old whole file or the new whole file, and no later failure has
    anything to undo.
    """
    destination = DESTINATION_DIR / cli
    try:
        os.replace(staged, destination)
    except OSError as exc:
        discard(staged)
        fail(f"could not install {cli} at {destination}: {exc}")
    return destination


def verify_unprivileged(destination: Path, identity: pwd.struct_passwd) -> tuple[str, str]:
    """Run it as the operator, never as root, in a tenant-equivalent context.

    Root must not execute a vendor binary it has just installed: the whole point
    of the promotion is that tenants run it, and tenants are not root.

    The identity is the TENANT's, not the operator's. Dropping to the operator
    proved only "not root": the operator can still read their own home and their
    own supplementary groups, so a binary that depends on an operator-only file
    verified cleanly and then failed for the account that actually runs it
    (SYRD-211 DAT rejection 2).

    Returns the reported version and the output, so a failure can be journalled
    with the reason rather than just a status.
    """
    home = Path(tempfile.mkdtemp(prefix="switchyard-cli-verify."))
    try:
        os.chown(home, identity.pw_uid, identity.pw_gid)
        try:
            groups = [identity.pw_gid]
            proc = subprocess.run(
                [str(destination), "--version"],
                cwd=str(home),
                env={
                    "PATH": PANE_BASE_PATH,
                    "HOME": str(home),
                    "USER": identity.pw_name,
                    "LOGNAME": identity.pw_name,
                    "LANG": "C.UTF-8",
                },
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                timeout=60,
                user=identity.pw_uid,
                group=identity.pw_gid,
                extra_groups=groups,
            )
        except subprocess.TimeoutExpired:
            return "", "timeout: it did not answer --version within 60s"
        except OSError as exc:
            return "", f"could not be executed as {identity.pw_name}: {exc}"
    finally:
        shutil.rmtree(home, ignore_errors=True)
    output = (proc.stdout or "").strip()
    if proc.returncode != 0:
        return "", f"exited {proc.returncode} as {identity.pw_name}: {output[:200]}"
    return (output.splitlines()[0] if output else ""), ""


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        fail("must run as root, through sudo")
    project = ""
    args = list(argv)
    if len(args) >= 2 and args[-2] == "--project":
        project = args[-1]
        args = args[:-2]
    if len(args) != 2:
        fail("usage: switchyard-promote-agent-cli <cli> <source-executable> [--project <slug>]")
    operator = calling_operator()
    cli = validated_cli(args[0])
    identity, whose = verification_identity(project, operator)

    fd = opened_source(cli, args[1], operator)
    try:
        staged = stage_candidate(fd, cli)
    finally:
        os.close(fd)

    # Proved BEFORE anything is replaced, and proved for the account that will
    # actually run it.
    version, problem = verify_unprivileged(staged, identity)
    if problem:
        discard(staged)
        fail(
            f"{cli} from {args[1]} does not work for the {whose}: {problem}. "
            "Nothing has been replaced"
        )

    destination = commit_candidate(staged, cli)
    print(
        f"{PROGRAM}: promoted {args[1]} to {destination} for {operator.pw_name}, "
        f"owned by root, mode 0755"
    )
    print(
        f"{PROGRAM}: {cli} verified as the {whose}"
        + (f" ({version})" if version else " (version not reported)")
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
