#!/usr/bin/env python3
"""Publish one role's feature ref as the project owner, safely.

A role account runs this through sudo as the project owner so the owner's git
identity performs the push and the role never gains read access to the owner's
SSH key files. Three things make the grant genuinely narrow (SYRD-39):

* Nothing about WHERE is caller-supplied. The calling role comes from SUDO_USER,
  and its worktree and the remote come from the project's own configuration, so
  a role cannot aim the owner's credentials at another repository or remote.
* The ref is namespaced to the calling role and integration branches are
  refused, so a role publishes its own feature refs and cannot write the branch
  the Director integrates.
* The owner never runs git inside the role's checkout. A role controls its own
  repository configuration, and knobs such as core.sshCommand,
  uploadpack.packObjectsHook and ext:: remote URLs turn "run git there" into
  "run the role's command as the owner". The role hands over a bundle instead --
  which it creates as itself -- and the owner fetches from that bundle into an
  owner-owned staging repository whose config the role cannot touch.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys
import time
from pathlib import Path

PROTECTED_REFS = frozenset({"main", "master", "trunk", "release", "head"})
# The sudoers grant allows any arguments, so the project identifier is validated
# before it is used to build any path. Without this, --project ../../tmp/forged
# loaded a role-written document and with it a role-chosen role mapping and
# remote (SYRD-39).
PROJECT_SLUG = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
REF_SEGMENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
# The owner's staging repository. Owner-owned, so its configuration -- including
# the remote and any transport settings -- is never role-controlled.
STAGING_DIR_NAME = ".local/state/switchyard/publish-staging"
PROJECT_REGISTRY_DIR = Path("/etc/switchyard/projects")
PROJECT_REGISTRY_SCHEMA = "switchyard.project-registry.v1"
REGISTRY_TEST_ROOT_ENV = "SWITCHYARD_PUBLISH_REGISTRY_ROOT"
# The board verifies a submitted commit_hash against one bare cache, named by
# its own unit. Reading the unit is how this program learns which one: the
# tenant's cache is not derivable from the slug, and guessing produced a path
# the board does not read (SYRD-73). Root owns the unit, so the name cannot be
# chosen by a role.
BOARD_UNIT_DIR = Path("/etc/systemd/system")
BOARD_UNIT_TEST_DIR_ENV = "SWITCHYARD_PUBLISH_UNIT_DIR"
COMMIT_CACHE_ENVIRONMENT_KEY = "TICKET_BOARD_COMMIT_GIT_DIR"
# Publication is remote; the ref does not always resolve on the first read.
PUBLIC_REF_ATTEMPTS = 5
CACHE_FETCH_ATTEMPTS = 3
RETRY_DELAY_SECONDS = 1.0
OWNER_TEST_HOME_ENV = "SWITCHYARD_PUBLISH_OWNER_HOME"


def fail(message: str) -> "NoReturn":  # type: ignore[valid-type]
    raise SystemExit(f"switchyard-publish-ref: {message}")


def calling_role_account() -> str:
    account = (os.environ.get("SUDO_USER") or "").strip()
    if not account:
        fail("must be run through sudo by a role account")
    return account


def validate_project(project: str) -> str:
    name = project.strip()
    if not PROJECT_SLUG.fullmatch(name):
        fail(f"{project!r} is not a valid project name")
    return name


def _contained(path: Path, root: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=False))
    except (OSError, RuntimeError, ValueError):
        return False
    return True


def _read_trusted_json(
    path: Path,
    *,
    description: str,
    expected_uid: int,
    expected_gid: int | None = None,
    reject_group_write: bool = False,
) -> dict:
    try:
        info = path.lstat()
    except (OSError, ValueError) as exc:
        fail(f"cannot read {description} {path}: {getattr(exc, 'strerror', None) or exc}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail(f"{description} {path} must be a regular file, not a link")
    if info.st_uid != expected_uid:
        fail(f"{description} {path} is not owned by the trusted account")
    if expected_gid is not None and info.st_gid != expected_gid:
        fail(f"{description} {path} is not in the trusted account group")
    forbidden_write = stat.S_IWOTH | (stat.S_IWGRP if reject_group_write else 0)
    if info.st_mode & forbidden_write:
        fail(f"{description} {path} is writable by an untrusted account")
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read {description} {path}: {exc}")
    if not isinstance(document, dict):
        fail(f"{description} {path} is not a JSON object")
    return document


def _require_trusted_owner_path(
    path: Path,
    *,
    projects_root: Path,
    owner_uid: int,
    owner_gid: int,
    directory: bool = False,
) -> Path:
    if not path.is_absolute():
        fail("registered project configuration path must be absolute")
    lexical_root = Path(os.path.abspath(projects_root))
    lexical_path = Path(os.path.abspath(path))
    try:
        lexical_path.relative_to(lexical_root)
    except ValueError:
        fail(f"registered project configuration escapes {projects_root}: {path}")
    try:
        original = lexical_path.lstat()
    except (OSError, ValueError) as exc:
        fail(
            f"registered project configuration is stale: {lexical_path}: "
            f"{getattr(exc, 'strerror', None) or exc}"
        )
    expected_type = stat.S_ISDIR if directory else stat.S_ISREG
    if stat.S_ISLNK(original.st_mode) or not expected_type(original.st_mode):
        kind = "directory" if directory else "regular file"
        fail(f"registered project path {lexical_path} must be a real {kind}, not a link")
    try:
        resolved = lexical_path.resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as exc:
        fail(f"registered project configuration is stale: {path}: {exc}")
    if not _contained(resolved, projects_root):
        fail(f"registered project configuration escapes {projects_root}: {path}")

    # Every directory that can replace the registered file is controlled by
    # root or the project owner. The owner's primary group is accepted because
    # generated provision directories deliberately use owner-group mode 0775;
    # role accounts are not members of that group.
    # Inspect lexical components as well as the resolved destination. This
    # rejects an owner path that traverses a replaceable symlink even when that
    # symlink currently lands back inside Projects.
    current = lexical_path if directory else lexical_path.parent
    root = lexical_root
    while True:
        try:
            info = current.lstat()
        except (OSError, ValueError) as exc:
            fail(
                f"cannot inspect registered project path {current}: "
                f"{getattr(exc, 'strerror', None) or exc}"
            )
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            fail(f"registered project path component {current} is not a real directory")
        if info.st_uid not in {0, owner_uid}:
            fail(f"registered project path component {current} has an untrusted owner")
        if info.st_mode & stat.S_IWOTH:
            fail(f"registered project path component {current} is world-writable")
        if info.st_mode & stat.S_IWGRP and info.st_gid != owner_gid:
            fail(f"registered project path component {current} has an untrusted writable group")
        if current == root:
            break
        current = current.parent
    return resolved


def load_project(
    project: str,
    *,
    owner_home: Path | None = None,
    owner_uid: int | None = None,
    owner_gid: int | None = None,
    registry_root: Path | None = None,
    registry_uid: int | None = None,
) -> dict:
    """Find the project configuration without trusting the caller.

    The location is derived from the effective uid -- the owner this is running
    as -- rather than from an argument, because the sudoers grant allows any
    arguments and a caller-supplied path would let a role aim the owner's
    credentials at a configuration of its own making.

    The root-owned registry is the only name-to-checkout authority. Its
    config_path may name a checkout whose basename differs from the project
    slug; the resolved configuration must still live below the owner's Projects
    tree and be controlled by that owner.
    """
    import pwd as _pwd

    owner = _pwd.getpwuid(os.geteuid())
    test_registry_root = os.environ.get(REGISTRY_TEST_ROOT_ENV, "").strip()
    test_owner_home = os.environ.get(OWNER_TEST_HOME_ENV, "").strip()
    resolved_registry_root = (
        Path(registry_root)
        if registry_root is not None
        else Path(test_registry_root)
        if test_registry_root
        else PROJECT_REGISTRY_DIR
    )
    resolved_registry_uid = (
        registry_uid
        if registry_uid is not None
        else owner.pw_uid
        if test_registry_root
        else 0
    )
    resolved_home = (
        Path(owner_home)
        if owner_home is not None
        else Path(test_owner_home)
        if test_owner_home
        else Path(owner.pw_dir)
    )
    resolved_owner_uid = owner.pw_uid if owner_uid is None else owner_uid
    resolved_owner_gid = owner.pw_gid if owner_gid is None else owner_gid
    projects_root = resolved_home / "Projects"
    try:
        registry_root_info = resolved_registry_root.lstat()
    except OSError as exc:
        fail(f"cannot inspect project registry {resolved_registry_root}: {exc.strerror}")
    if stat.S_ISLNK(registry_root_info.st_mode) or not stat.S_ISDIR(registry_root_info.st_mode):
        fail(f"project registry {resolved_registry_root} must be a real directory")
    if registry_root_info.st_uid != resolved_registry_uid:
        fail(f"project registry {resolved_registry_root} is not owned by the trusted account")
    if registry_root_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"project registry {resolved_registry_root} is writable by an untrusted account")
    registry_path = resolved_registry_root / f"{project}.json"
    if not _contained(registry_path, resolved_registry_root):
        fail(f"registry path escapes {resolved_registry_root}")
    if not registry_path.exists():
        fail(f"no registered configuration found for project {project}")

    registry = _read_trusted_json(
        registry_path,
        description="project registry entry",
        expected_uid=resolved_registry_uid,
        reject_group_write=True,
    )
    if str(registry.get("schema") or "") != PROJECT_REGISTRY_SCHEMA:
        fail(f"project registry entry {registry_path} has an unsupported schema")
    if str(registry.get("slug") or "") != project:
        fail(f"project registry entry {registry_path} is not for project {project}")
    raw_config_path = registry.get("config_path")
    if not isinstance(raw_config_path, str) or not raw_config_path.strip():
        fail(f"project registry entry {registry_path} has no config_path")
    try:
        candidate = Path(raw_config_path)
    except (TypeError, ValueError) as exc:
        fail(f"project registry entry {registry_path} has an invalid config_path: {exc}")
    config_path = _require_trusted_owner_path(
        candidate,
        projects_root=projects_root,
        owner_uid=resolved_owner_uid,
        owner_gid=resolved_owner_gid,
    )
    document = _read_trusted_json(
        config_path,
        description="project configuration",
        expected_uid=resolved_owner_uid,
        expected_gid=resolved_owner_gid,
    )
    if str(document.get("project") or "") != project:
        fail(f"{config_path} is not the configuration for project {project}")

    repository = document.get("repository")
    if not isinstance(repository, str) or not repository.strip():
        fail(f"project configuration {config_path} has no owner repository")
    repository_path = _require_trusted_owner_path(
        Path(repository),
        projects_root=projects_root,
        owner_uid=resolved_owner_uid,
        owner_gid=resolved_owner_gid,
        directory=True,
    )
    document["repository"] = str(repository_path)
    return document


def role_for_account(config: dict, account: str) -> dict:
    for role in config.get("roles", []):
        if isinstance(role, dict) and str(role.get("run_as_user") or "") == account:
            return role
    fail(f"{account} is not a configured role account of this project")


def validate_ref(ref: str, role_name: str) -> str:
    name = ref.strip()
    if not name:
        fail("a ref name is required")
    if name.startswith("refs/"):
        fail("pass a branch name, not a full ref path")
    segments = name.split("/")
    if any(not REF_SEGMENT.fullmatch(segment) or segment.endswith(".lock") for segment in segments):
        fail(f"{name!r} is not a valid branch name")
    if segments[0].casefold() in PROTECTED_REFS or name.casefold() in PROTECTED_REFS:
        fail(
            f"{name} is an integration branch; roles publish their own feature refs and the "
            "Director integrates them"
        )
    # Bound to the caller: a role publishes under its own namespace and cannot
    # write, move or delete another role's refs.
    if segments[0] != role_name:
        fail(f"{role_name} may only publish refs under {role_name}/, not {name}")
    if len(segments) < 2:
        fail(f"{role_name} must publish a ref below its namespace, such as {role_name}/my-work")
    return name


def require_role_owned_file(path: Path, account: str) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"cannot read bundle {path}: {exc.strerror}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail(f"bundle {path} must be a regular file, not a link")
    import pwd

    try:
        expected = pwd.getpwnam(account).pw_uid
    except KeyError:
        fail(f"{account} is not a local account")
    if info.st_uid != expected:
        fail(f"bundle {path} is not owned by {account}")


def resolve_remote_url(config: dict, remote_name: str) -> str:
    """Turn the configured remote NAME into a URL from an owner-owned checkout.

    Generated configuration stores a name such as "origin". A freshly created
    staging repository has no remotes, so pushing by name fails; and the URL must
    not come from the role's checkout, whose configuration the role controls.
    """
    if "://" in remote_name or remote_name.startswith("/") or ":" in remote_name:
        # Already a URL or an scp-style location.
        return remote_name
    repository = str(config.get("repository") or "").strip()
    if not repository:
        fail(f"project configuration names remote {remote_name} but no owner repository")
    resolved = git(["-C", repository, "remote", "get-url", remote_name])
    if resolved.returncode != 0 or not resolved.stdout.strip():
        fail(f"{repository} has no remote named {remote_name}")
    return resolved.stdout.strip()


def configured_commit_cache(
    project: str,
    *,
    unit_dir: Path | None = None,
    unit_uid: int | None = None,
    owner_uid: int | None = None,
) -> Path:
    """The bare cache the board verifies submitted commits against.

    Read from the tenant's own board unit rather than derived from the slug.
    The two are not the same path on a real host, and deriving one produced a
    cache the board never reads, which is the whole shape of SYRD-73. Root owns
    the unit, so a role cannot choose which cache gets refreshed.
    """
    import pwd as _pwd

    test_dir = os.environ.get(BOARD_UNIT_TEST_DIR_ENV, "").strip()
    resolved_dir = (
        Path(unit_dir)
        if unit_dir is not None
        else Path(test_dir)
        if test_dir
        else BOARD_UNIT_DIR
    )
    trusted_uid = (
        unit_uid
        if unit_uid is not None
        else 0
        if (unit_dir is None and not test_dir)
        else os.geteuid()
    )
    unit_path = resolved_dir / f"{project}-ticket-board.service"
    if not _contained(unit_path, resolved_dir):
        fail(f"board unit path escapes {resolved_dir}")
    try:
        info = unit_path.lstat()
    except OSError as exc:
        fail(f"cannot read board unit {unit_path}: {exc.strerror}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail(f"board unit {unit_path} must be a regular file, not a link")
    if info.st_uid != trusted_uid:
        fail(f"board unit {unit_path} is not owned by the trusted account")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"board unit {unit_path} is writable by an untrusted account")
    try:
        lines = unit_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        fail(f"cannot read board unit {unit_path}: {exc.strerror}")

    # Last assignment wins, the way systemd reads it, so a value appended later
    # in the unit is the one actually in force.
    value = ""
    for line in lines:
        stripped = line.strip()
        if not stripped.startswith("Environment="):
            continue
        assignment = stripped[len("Environment=") :].strip().strip('"')
        key, separator, candidate = assignment.partition("=")
        if separator and key.strip() == COMMIT_CACHE_ENVIRONMENT_KEY:
            value = candidate.strip().strip('"')
    if not value:
        fail(
            f"board unit {unit_path} names no {COMMIT_CACHE_ENVIRONMENT_KEY}; "
            "the trusted commit cache is not configured for this tenant"
        )
    cache = Path(value)
    if not cache.is_absolute():
        fail(f"configured commit cache {value} is not an absolute path")
    owner = _pwd.getpwuid(os.geteuid())
    expected_owner_uid = owner.pw_uid if owner_uid is None else owner_uid
    try:
        cache_info = cache.lstat()
    except OSError as exc:
        fail(f"cannot inspect configured commit cache {cache}: {exc.strerror}")
    if stat.S_ISLNK(cache_info.st_mode) or not stat.S_ISDIR(cache_info.st_mode):
        fail(f"configured commit cache {cache} must be a real directory, not a link")
    # Fetching into it is the least-privilege refresh precisely because the
    # owner already owns it: no root, no helper, no second account.
    if cache_info.st_uid != expected_owner_uid:
        fail(f"configured commit cache {cache} is not owned by this project account")
    if cache_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"configured commit cache {cache} is writable by an untrusted account")
    return cache


def remote_ref_commit(remote_url: str, ref: str) -> str | None:
    """What the public remote says the ref is, or None when it cannot be read."""
    listed = git(["ls-remote", remote_url, f"refs/heads/{ref}"])
    if listed.returncode != 0:
        return None
    for line in listed.stdout.splitlines():
        commit, _, name = line.partition("\t")
        if name.strip() == f"refs/heads/{ref}":
            return commit.strip()
    return ""


def refresh_commit_cache(
    cache: Path,
    remote_url: str,
    ref: str,
    expected_commit: str,
    *,
    sleep=time.sleep,
) -> str | None:
    """Fetch exactly this ref into the cache, or say why the work is not ready.

    Only the published ref is fetched, into its own remote-tracking name, so two
    roles publishing at once touch different refs and neither can move the
    other's. Returns None on success and the reason on failure.
    """
    problem = "the cache was never fetched"
    for attempt in range(CACHE_FETCH_ATTEMPTS):
        if attempt:
            sleep(RETRY_DELAY_SECONDS)
        fetched = git(
            [
                "--git-dir",
                str(cache),
                "fetch",
                remote_url,
                f"+refs/heads/{ref}:refs/remotes/origin/{ref}",
            ]
        )
        if fetched.returncode != 0:
            problem = (fetched.stderr or fetched.stdout or "git fetch failed").strip()
            continue
        resolved = git(["--git-dir", str(cache), "rev-parse", f"refs/remotes/origin/{ref}^{{commit}}"])
        if resolved.returncode != 0:
            problem = (resolved.stderr or "cache does not resolve the fetched ref").strip()
            continue
        landed = resolved.stdout.strip()
        if landed != expected_commit:
            # The ref moved between the push and this fetch, so the cache holds
            # a commit that is not the one being submitted. Refusing is the
            # point: a submission against it would review somebody else's work.
            return (
                f"the trusted cache resolved {ref} to {landed}, not {expected_commit}; "
                "the public ref changed after this publication"
            )
        return None
    return f"could not refresh the trusted commit cache {cache}: {problem}"


def git(args: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    # System and global git configuration are ignored so the push cannot be
    # redirected by anything outside this program's control.
    env = {
        **os.environ,
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
    }
    return subprocess.run(["git", *args], text=True, capture_output=True, env=env, **kwargs)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="switchyard-publish-ref")
    parser.add_argument("--project", required=True)
    parser.add_argument("--ref", required=True, help="branch to publish, under <role>/")
    parser.add_argument(
        "--bundle",
        required=True,
        help="git bundle the role created, containing the commits to publish",
    )
    args = parser.parse_args(argv[1:])

    account = calling_role_account()
    project = validate_project(args.project)
    config = load_project(project)
    role = role_for_account(config, account)
    role_name = str(role.get("role") or "")
    ref = validate_ref(args.ref, role_name)
    bundle = Path(args.bundle).expanduser()
    require_role_owned_file(bundle, account)

    verify = git(["bundle", "verify", str(bundle)])
    if verify.returncode != 0:
        sys.stderr.write(verify.stderr)
        fail("bundle did not verify")

    # worktree_remote is a remote NAME in generated configuration, so it is
    # resolved to a URL from the owner's own project checkout. A fresh staging
    # repository has no remotes at all, which is why pushing by name failed.
    remote_name = str(config.get("worktree_remote") or "origin")
    remote_url = resolve_remote_url(config, remote_name)
    staging = Path.home() / STAGING_DIR_NAME / project
    if not (staging / "HEAD").exists():
        staging.mkdir(parents=True, exist_ok=True)
        staging.chmod(0o700)
        init = git(["init", "--bare", "-q", str(staging)])
        if init.returncode != 0:
            sys.stderr.write(init.stderr)
            fail("could not create the owner staging repository")

    fetch = git(["-C", str(staging), "fetch", str(bundle), f"refs/heads/{ref}:refs/heads/{ref}", "--force"])
    if fetch.returncode != 0:
        sys.stderr.write(fetch.stderr)
        fail(f"bundle does not contain refs/heads/{ref}")
    staged = git(["-C", str(staging), "rev-parse", f"refs/heads/{ref}^{{commit}}"])
    if staged.returncode != 0 or not staged.stdout.strip():
        fail(f"staging repository does not resolve refs/heads/{ref}")
    published_commit = staged.stdout.strip()

    # Resolved before the push, so a tenant whose cache is unconfigured or
    # untrustworthy is refused while nothing has been published yet.
    cache = configured_commit_cache(project)

    configure = git(["-C", str(staging), "remote", "set-url", "publish", remote_url])
    if configure.returncode != 0:
        added = git(["-C", str(staging), "remote", "add", "publish", remote_url])
        if added.returncode != 0:
            sys.stderr.write(added.stderr)
            fail("could not configure the staging remote")
    verify_remote = git(["-C", str(staging), "remote", "get-url", "publish"])
    if verify_remote.returncode != 0 or verify_remote.stdout.strip() != remote_url:
        fail("staging remote did not resolve to the configured URL")
    push = git(["-C", str(staging), "push", "publish", f"refs/heads/{ref}:refs/heads/{ref}"])
    sys.stdout.write(push.stdout)
    sys.stderr.write(push.stderr)
    if push.returncode != 0:
        return push.returncode

    # Everything from here is what makes the publication usable. The push
    # landing is not the same as the work being submittable: the board verifies
    # a commit_hash against its own cache, and a push that never reached that
    # cache produced `unknown commit_hash` on the role's very next action
    # (SYRD-75). So the ref is confirmed on the public remote and the cache is
    # refreshed before this reports success -- and when either fails, it says
    # the push landed and the work is not ready, rather than printing
    # "published" and leaving the role to discover it.
    public_commit = None
    for attempt in range(PUBLIC_REF_ATTEMPTS):
        if attempt:
            time.sleep(RETRY_DELAY_SECONDS)
        public_commit = remote_ref_commit(remote_url, ref)
        if public_commit == published_commit:
            break
    if public_commit != published_commit:
        return not_workflow_ready(
            ref,
            published_commit,
            f"the public ref reads {public_commit or 'nothing'} rather than {published_commit}",
        )

    problem = refresh_commit_cache(cache, remote_url, ref, published_commit)
    if problem is not None:
        return not_workflow_ready(ref, published_commit, problem)

    print(
        f"switchyard-publish-ref: published {ref} for {role_name} at {published_commit}; "
        f"trusted commit cache {cache} refreshed"
    )
    return 0


def not_workflow_ready(ref: str, commit: str, problem: str) -> int:
    """Publication landed; the work is not submittable. Say both, and fail."""
    sys.stderr.write(
        f"switchyard-publish-ref: {ref} was pushed at {commit}, but {problem}.\n"
        "switchyard-publish-ref: the commit is NOT ready to submit -- the board "
        "verifies commit_hash against its trusted cache and would refuse it. "
        "Re-run this command once the cause is resolved; publishing the same ref "
        "again is safe.\n"
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
