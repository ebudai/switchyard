#!/usr/bin/env python3
"""Publish one implementer's ref, for the one process the board says may ask.

Every role in a project now runs as one Unix account (SYRD-69). That made the
old shape of this program impossible: it took the calling role from SUDO_USER
and hopped from a per-role account to the project owner, and with one account
there is no hop to make and no role to read. Worse, it made the old shape
pointless -- a credential the project account can use is a credential every role
can use, so "the implementer publishes its own ref" and "any role pushes
anything" became the same sentence.

So publication is not something a role does with a credential any more. It is
something a role ASKS FOR, on the board, durably; this program is what the
control role runs to answer one ask. Four things keep the grant narrow:

* WHO. Not the caller's word, not the shared uid, not a pane name, not an
  environment variable. This walks its own process ancestry to the pane root the
  kernel put it under, and requires that exact (pid, start time, uid) to be the
  live runtime the board registered for the role holding control authority. A
  sibling role process under the same uid resolves to its own pane root and is
  refused; a stale or replaced process no longer matches the row.
* WHAT. One request id. The ref, the commit, the bundle and the role they belong
  to come from the board's own record of what the implementer asked for, so a
  caller cannot aim this at a ref nobody requested.
* WHERE. The project registry is root-owned, the board unit is root-owned, and
  everything else -- the checkout, the remote, the trusted commit cache, the
  board to ask -- is read from those. The project account owns its configuration
  and could otherwise name a board of its own making.
* WITH WHAT. The push credential is root-owned and never readable by the project
  account, which is the whole difference between this and handing every role a
  key. The trusted cache is refreshed from a root-owned local mirror instead,
  as the project account and with no credential at all.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# Staged flat beside this program, in a directory root owns, and imported
# from there so the two privileged operations cannot drift apart.
sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))

from switchyard_publication_authority import *  # noqa: F403
from switchyard_publication_authority import (  # noqa: F401
    COMMIT,
    PROTECTED_REFS,
    REF_SEGMENT,
    board_unit,
    fail,
    git,
    load_project,
    publish_grant,
    remote_ref_commit,
    remote_url_for,
    require_control_caller,
    require_owner_bundle,
    refresh_commit_cache,
    ssh_command_for,
    staging_repository,
    validate_project,
)


def fetch_request(board_url: str, request_id: int) -> dict:
    listing = board_get(board_url, "/api/publications?state=requested")
    for row in listing.get("requests") or []:
        if isinstance(row, dict) and int(row.get("id") or 0) == request_id:
            return row
    fail(
        f"publication request {request_id} is not open on this board; it may already have been "
        "published, rejected, or replaced by a later request"
    )


def ref_problem(ref: str, role: str) -> str | None:
    """The same rule the board applies, asked again here rather than assumed."""
    name = ref.strip()
    if not name:
        return "a ref name is required"
    if name.startswith("refs/"):
        return "the request names a full ref path rather than a branch"
    segments = name.split("/")
    for segment in segments:
        if not REF_SEGMENT.fullmatch(segment) or segment.endswith(".lock"):
            return f"{name} is not a valid branch name"
    if name.casefold() in PROTECTED_REFS or segments[0].casefold() in PROTECTED_REFS:
        return f"{name} collides with an integration branch"
    if segments[0] == "roles":
        if len(segments) < 3 or segments[1] != role:
            return f"{name} is not in {role}'s namespace"
        return None
    if len(segments) < 2 or segments[0] != role:
        return f"{name} is not in {role}'s namespace"
    return None


def not_workflow_ready(ref: str, commit: str, problem: str) -> int:
    """Publication landed; the work is not submittable. Say both, and fail."""
    sys.stderr.write(
        f"switchyard-publish-ref: {ref} was pushed at {commit}, but {problem}.\n"
        "switchyard-publish-ref: the commit is NOT ready to submit -- the board verifies "
        "commit_hash against its trusted cache and would refuse it. Re-running this for the "
        "same request is safe.\n"
    )
    return 1


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="switchyard-publish-ref")
    parser.add_argument("--project", required=True)
    parser.add_argument(
        "--request",
        required=True,
        type=int,
        help="the board's publication request id; everything else comes from that record",
    )
    args = parser.parse_args(argv[1:])

    project = validate_project(args.project)
    unit = board_unit(project)
    control_role = require_control_caller(unit["board_url"])
    request = fetch_request(unit["board_url"], args.request)
    role = str(request.get("requested_by") or "")
    ref = str(request.get("ref") or "")
    commit = str(request.get("commit_hash") or "").lower()
    bundle = Path(str(request.get("bundle_path") or ""))
    problem = ref_problem(ref, role)
    if problem is not None:
        fail(f"refusing publication request {args.request}: {problem}")
    if not COMMIT.fullmatch(commit):
        fail(f"refusing publication request {args.request}: {commit!r} is not a commit")

    config = load_project(project)
    grant = publish_grant(project)
    owner_uid, owner_gid = int(config["owner_uid"]), int(config["owner_gid"])
    require_owner_bundle(bundle, owner_uid)

    verified = git(["bundle", "verify", str(bundle)])
    if verified.returncode != 0:
        sys.stderr.write(verified.stderr)
        fail("bundle did not verify")

    staging = staging_repository(project)
    fetched = git(
        ["-C", str(staging), "fetch", str(bundle), f"+refs/heads/{ref}:refs/heads/{ref}"]
    )
    if fetched.returncode != 0:
        sys.stderr.write(fetched.stderr)
        fail(f"bundle does not contain refs/heads/{ref}")
    staged = git(["-C", str(staging), "rev-parse", f"refs/heads/{ref}^{{commit}}"])
    if staged.returncode != 0 or staged.stdout.strip() != commit:
        fail(
            f"the bundle's {ref} is {staged.stdout.strip() or 'unresolvable'}, not the requested "
            f"{commit}; publish the request the implementer actually filed"
        )

    cache = Path(unit["commit_cache"])
    try:
        cache_info = cache.lstat()
    except OSError as exc:
        fail(f"cannot inspect configured commit cache {cache}: {exc.strerror}")
    if stat.S_ISLNK(cache_info.st_mode) or not stat.S_ISDIR(cache_info.st_mode):
        fail(f"configured commit cache {cache} must be a real directory, not a link")
    if cache_info.st_uid != owner_uid:
        fail(f"configured commit cache {cache} is not owned by the project account")
    if cache_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"configured commit cache {cache} is writable by an untrusted account")

    remote_url = remote_url_for(grant)
    ssh_command = ssh_command_for(grant)
    pushed = git(
        ["-C", str(staging), "push", remote_url, f"refs/heads/{ref}:refs/heads/{ref}"],
        ssh_command=ssh_command,
    )
    sys.stdout.write(pushed.stdout)
    sys.stderr.write(pushed.stderr)
    if pushed.returncode != 0:
        return pushed.returncode

    public_commit = None
    for attempt in range(PUBLIC_REF_ATTEMPTS):
        if attempt:
            time.sleep(RETRY_DELAY_SECONDS)
        public_commit = remote_ref_commit(remote_url, ref, ssh_command)
        if public_commit == commit:
            break
    if public_commit != commit:
        return not_workflow_ready(
            ref, commit, f"the public ref reads {public_commit or 'nothing'} rather than {commit}"
        )

    stale = refresh_commit_cache(
        cache, staging, ref, commit, owner_uid=owner_uid, owner_gid=owner_gid
    )
    if stale is not None:
        return not_workflow_ready(ref, commit, stale)

    print(
        json.dumps(
            {
                "published": True,
                "project": project,
                "request": args.request,
                "role": role,
                "ref": ref,
                "commit": commit,
                "control_role": control_role,
                "cache": str(cache),
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
