#!/usr/bin/env python3
"""Compatibility shim: publishing a candidate is a push again (SYRD-123).

There is no publication request any more. Every role runs as the account that
holds the project's GitHub credential, so an implementer publishes by pushing,
and `switchyard-publish-candidate` is that push. This name stays because panes,
notes and habits still reach for it; it says what changed once and then does the
thing the caller meant.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

REPLACEMENT = "switchyard-publish-candidate"


def main(argv: list[str]) -> int:
    sys.stderr.write(
        "switchyard-request-publication: publication is a direct push now; running "
        f"{REPLACEMENT} instead. Use that name (SYRD-123).\n"
    )
    beside = Path(os.path.realpath(__file__)).parent / REPLACEMENT
    if beside.exists():
        # Staged flat beside this one, and run through this interpreter so the
        # shim works from a checkout whose scripts are not on PATH.
        os.execv(sys.executable, [sys.executable, str(beside), *argv[1:]])
    os.execvp(REPLACEMENT, [REPLACEMENT, *argv[1:]])
    return 1  # unreachable: exec replaces this process or raises


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
