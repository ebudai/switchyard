#!/usr/bin/env python3
"""Install per-pane CLI idle hooks for ticket notification delivery."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import stat
import sys
import tomllib
from pathlib import Path
from typing import Any

from ticket_board.codex_hook_trust import (
    codex_command_hook_trust_entries,
    codex_trusted_hashes,
    render_codex_hook_trust_records,
)

HOOK_BASENAME = "ticket-board-pane-idle-hook"
LEGACY_HOOK_BASENAME = "pgu-ticket-board-pane-idle-hook"
DEFAULT_PROJECT = os.environ.get("TICKET_BOARD_PROJECT", "").strip() or os.environ.get("PGU_TICKET_BOARD_PROJECT", "").strip() or "pgu"
DEFAULT_PANE_STATE_DIR = (
    Path(os.environ["TICKET_BOARD_PANE_STATE_DIR"]).expanduser()
    if os.environ.get("TICKET_BOARD_PANE_STATE_DIR")
    else Path(os.environ["PGU_TICKET_BOARD_PANE_STATE_DIR"]).expanduser()
    if os.environ.get("PGU_TICKET_BOARD_PANE_STATE_DIR")
    else Path(f"/run/user/{os.getuid()}/{DEFAULT_PROJECT}-ticket-board/pane-state")
)
DEFAULT_PANE_SESSION_DIR = (
    Path(os.environ["TICKET_BOARD_PANE_SESSION_DIR"]).expanduser()
    if os.environ.get("TICKET_BOARD_PANE_SESSION_DIR")
    else Path(os.environ["PGU_TICKET_BOARD_PANE_SESSION_DIR"]).expanduser()
    if os.environ.get("PGU_TICKET_BOARD_PANE_SESSION_DIR")
    else Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    / f"{DEFAULT_PROJECT}-ticket-board"
    / "pane-sessions"
)
PANE_TARGETS = tuple(
    f"{DEFAULT_PROJECT}-{role}:0.0"
    for role in (
        "director",
        "main",
        "app",
        "perf",
        "research",
        "ops",
        "audit",
        "inspector",
    )
)


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _load_json(path: Path) -> dict[str, Any]:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    if not isinstance(parsed, dict):
        raise SystemExit(f"{path} must contain a JSON object")
    return parsed


def _write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def _load_yaml(path: Path) -> dict[str, Any]:
    try:
        import yaml
    except ImportError as exc:
        if not path.exists():
            return {}
        raise SystemExit(f"PyYAML is required to preserve existing Hermes config: {path}") from exc
    try:
        parsed = yaml.safe_load(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    if parsed is None:
        return {}
    if not isinstance(parsed, dict):
        raise SystemExit(f"{path} must contain a YAML object")
    return parsed


def _write_yaml(path: Path, payload: dict[str, Any]) -> None:
    try:
        import yaml
    except ImportError:
        rendered = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    else:
        rendered = yaml.safe_dump(payload, sort_keys=False)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(rendered, encoding="utf-8")
    tmp.replace(path)


def _contains_managed_hook(value: Any) -> bool:
    if isinstance(value, dict):
        return any(_contains_managed_hook(child) for child in value.values())
    if isinstance(value, list):
        return any(_contains_managed_hook(child) for child in value)
    return isinstance(value, str) and (HOOK_BASENAME in value or LEGACY_HOOK_BASENAME in value)


def _hook_entry(command: str, *, matcher: str = "") -> dict[str, Any]:
    entry: dict[str, Any] = {"hooks": [{"type": "command", "command": command}]}
    if matcher:
        entry["matcher"] = matcher
    return entry


def _flat_command_hook(command: str) -> dict[str, Any]:
    return {"type": "command", "command": command}


def _shell_command(parts: list[str | Path]) -> str:
    return " ".join(shlex.quote(str(part)) for part in parts)


def _merge_hook_entries(config: dict[str, Any], event: str, entries: list[dict[str, Any]]) -> None:
    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit("existing hooks field must be a JSON object")
    existing = hooks.get(event, [])
    if not isinstance(existing, list):
        raise SystemExit(f"existing hooks.{event} field must be a JSON list")
    hooks[event] = [entry for entry in existing if not _contains_managed_hook(entry)] + entries


def _merge_agy_named_hook(config: dict[str, Any], name: str, events: dict[str, list[dict[str, Any]]]) -> None:
    existing = config.get(name, {})
    if not isinstance(existing, dict):
        existing = {}
    for key, value in list(config.items()):
        if key != name and _contains_managed_hook(value):
            config.pop(key, None)
    cleaned = {
        key: value
        for key, value in existing.items()
        if key not in events and not _contains_managed_hook(value)
    }
    cleaned.update(events)
    config[name] = cleaned


def _install_hook_binary(source: Path, destination: Path) -> None:
    if not source.exists():
        raise SystemExit(f"hook source not found: {source}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    mode = destination.stat().st_mode
    destination.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def _install_claude_hooks(home: Path, hook_bin: Path) -> Path:
    path = home / ".claude" / "settings.json"
    config = _load_json(path)
    state_dir = DEFAULT_PANE_STATE_DIR
    session_dir = DEFAULT_PANE_SESSION_DIR
    _merge_hook_entries(
        config,
        "SessionStart",
        [
            _hook_entry(
                _shell_command(
                    [
                        hook_bin,
                        "idle",
                        "--source",
                        "claude.SessionStart",
                        "--state-dir",
                        state_dir,
                        "--session-dir",
                        session_dir,
                        "--record-session",
                    ]
                )
            )
        ],
    )
    _merge_hook_entries(
        config,
        "Notification",
        [
            _hook_entry(
                _shell_command(
                    [
                        hook_bin,
                        "idle",
                        "--source",
                        "claude.Notification.idle_prompt",
                        "--state-dir",
                        state_dir,
                        "--session-dir",
                        session_dir,
                    ]
                ),
                matcher="idle_prompt",
            )
        ],
    )
    _merge_hook_entries(
        config,
        "UserPromptSubmit",
        [
            _hook_entry(
                _shell_command(
                    [
                        hook_bin,
                        "busy",
                        "--source",
                        "claude.UserPromptSubmit",
                        "--state-dir",
                        state_dir,
                        "--session-dir",
                        session_dir,
                    ]
                )
            )
        ],
    )
    _merge_hook_entries(
        config,
        "Stop",
        [
            _hook_entry(
                _shell_command(
                    [hook_bin, "idle", "--source", "claude.Stop", "--state-dir", state_dir, "--session-dir", session_dir]
                )
            )
        ],
    )
    _write_json(path, config)
    return path


def _install_codex_hooks(home: Path, hook_bin: Path) -> Path:
    path = home / ".codex" / "hooks.json"
    config = _load_json(path)
    state_dir = DEFAULT_PANE_STATE_DIR
    session_dir = DEFAULT_PANE_SESSION_DIR
    _merge_hook_entries(
        config,
        "SessionStart",
        [
            _hook_entry(
                _shell_command(
                    [
                        hook_bin,
                        "idle",
                        "--source",
                        "codex.SessionStart",
                        "--state-dir",
                        state_dir,
                        "--session-dir",
                        session_dir,
                        "--record-session",
                    ]
                )
            )
        ],
    )
    _merge_hook_entries(
        config,
        "Stop",
        [
            _hook_entry(
                _shell_command(
                    [hook_bin, "idle", "--source", "codex.Stop", "--state-dir", state_dir, "--session-dir", session_dir]
                )
            )
        ],
    )
    _merge_hook_entries(
        config,
        "UserPromptSubmit",
        [
            _hook_entry(
                _shell_command(
                    [hook_bin, "busy", "--source", "codex.UserPromptSubmit", "--state-dir", state_dir, "--session-dir", session_dir]
                )
            )
        ],
    )
    _merge_hook_entries(
        config,
        "PermissionRequest",
        [
            _hook_entry(
                _shell_command(
                    [hook_bin, "blocked", "--source", "codex.PermissionRequest", "--state-dir", state_dir, "--session-dir", session_dir]
                )
            )
        ],
    )
    _write_json(path, config)
    return path


def _toml_loads(text: str) -> dict[str, Any]:
    try:
        parsed = tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise SystemExit(f"cannot seed Codex hook trust because config.toml is invalid: {exc}") from exc
    return parsed if isinstance(parsed, dict) else {}


def _has_hooks_state_table(config: dict[str, Any]) -> bool:
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        return False
    return isinstance(hooks.get("state"), dict)


def _seed_codex_hook_trust_if_new(
    home: Path,
    *,
    had_codex_hooks: bool,
    had_codex_trust_records: bool,
) -> str:
    if had_codex_trust_records:
        return "skipped Codex hook trust seed: existing trust records require manual /hooks re-approval"
    if had_codex_hooks:
        return "skipped Codex hook trust seed: existing hooks.json requires manual /hooks approval"

    entries = codex_command_hook_trust_entries(home)
    if not entries:
        return "skipped Codex hook trust seed: no installed Codex command hooks"

    config_path = home / ".codex" / "config.toml"
    existing = ""
    if config_path.exists():
        existing = config_path.read_text(encoding="utf-8")
        config = _toml_loads(existing)
    else:
        config = {}
    include_parent_header = not _has_hooks_state_table(config)
    addition = render_codex_hook_trust_records(entries, include_parent_header=include_parent_header)
    if existing and not existing.endswith("\n"):
        existing += "\n"
    if existing and addition:
        existing += "\n"
    config_path.parent.mkdir(parents=True, exist_ok=True)
    config_path.write_text(existing + addition, encoding="utf-8")
    return f"seeded Codex hook trust for {len(entries)} installed hooks"


def _install_gemini_hooks(home: Path, hook_bin: Path) -> Path:
    # agy 1.0.8 moved hook discovery to the shared Gemini config tree.
    # The old antigravity-cli/settings.json path is still used for other
    # settings, but current agy logs report hooks loaded from hooks.json files.
    path = home / ".gemini" / "config" / "hooks.json"
    config = _load_json(path)
    session_start_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "gemini.SessionStart",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
            "--record-session",
        ]
    )
    pre_invocation_command = _shell_command(
        [
            hook_bin,
            "busy",
            "--source",
            "gemini.PreInvocation",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    post_invocation_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "gemini.PostInvocation",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    stop_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "gemini.Stop",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    if _contains_managed_hook(config.get("hooks")):
        config.pop("hooks", None)
    _merge_agy_named_hook(
        config,
        "ticket-board-pane-state",
        {
            "SessionStart": [
                _flat_command_hook(
                    f"out=\"$({session_start_command})\" && "
                    "if [ -n \"$out\" ]; then printf '%s' \"$out\"; else printf '{}'; fi"
                )
            ],
            "PreInvocation": [
                _flat_command_hook(f"{pre_invocation_command} >/dev/null && printf '{{}}'")
            ],
            "PostInvocation": [
                _flat_command_hook(f"{post_invocation_command} >/dev/null && printf '{{}}'")
            ],
            "Stop": [
                _flat_command_hook(f"{stop_command} >/dev/null && printf '{{}}'")
            ],
        },
    )
    _write_json(path, config)
    return path


def _install_hermes_hooks(home: Path, hook_bin: Path) -> Path:
    path = home / ".hermes" / "config.yaml"
    config = _load_yaml(path)
    session_start_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "hermes.on_session_start",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
            "--record-session",
        ]
    )
    llm_start_command = _shell_command(
        [
            hook_bin,
            "busy",
            "--source",
            "hermes.pre_llm_call",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    llm_end_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "hermes.post_llm_call",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    session_end_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "hermes.on_session_end",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    session_finalize_command = _shell_command(
        [
            hook_bin,
            "idle",
            "--source",
            "hermes.on_session_finalize",
            "--state-dir",
            DEFAULT_PANE_STATE_DIR,
            "--session-dir",
            DEFAULT_PANE_SESSION_DIR,
        ]
    )
    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit("existing Hermes hooks field must be a YAML object")
    managed_entries = {
        "on_session_start": [{"command": session_start_command}],
        "pre_llm_call": [{"command": llm_start_command}],
        "post_llm_call": [{"command": llm_end_command}],
        "on_session_end": [{"command": session_end_command}],
        "on_session_finalize": [{"command": session_finalize_command}],
    }
    for event, entries in managed_entries.items():
        existing = hooks.get(event, [])
        if not isinstance(existing, list):
            raise SystemExit(f"existing Hermes hooks.{event} field must be a YAML list")
        hooks[event] = [entry for entry in existing if not _contains_managed_hook(entry)] + entries
    _write_yaml(path, config)
    return path


def _target_path(state_dir: Path, target: str) -> Path:
    safe = "".join(ch if ch.isalnum() or ch in ".-" else "_" for ch in target)
    return state_dir / f"{safe}.json"


def _read_state(path: Path, target: str) -> str:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return ""
    if not isinstance(parsed, dict) or parsed.get("target") != target:
        return ""
    state = str(parsed.get("state") or "").strip().lower()
    return state if state in {"idle", "busy", "blocked"} else ""


def install(args: argparse.Namespace) -> int:
    home = Path(args.home).expanduser()
    hook_source = Path(args.hook_source).expanduser()
    hook_bin = Path(args.bin_path).expanduser()
    had_codex_hooks = (home / ".codex" / "hooks.json").exists()
    had_codex_trust_records = bool(codex_trusted_hashes(home))
    _install_hook_binary(hook_source, hook_bin)
    written = [
        _install_claude_hooks(home, hook_bin),
        _install_codex_hooks(home, hook_bin),
        _install_gemini_hooks(home, hook_bin),
        _install_hermes_hooks(home, hook_bin),
    ]
    codex_seed_result = ""
    if args.seed_codex_hook_trust_if_new:
        codex_seed_result = _seed_codex_hook_trust_if_new(
            home,
            had_codex_hooks=had_codex_hooks,
            had_codex_trust_records=had_codex_trust_records,
        )
    print(f"installed {hook_bin}")
    for path in written:
        print(f"wrote {path}")
    if codex_seed_result:
        print(codex_seed_result)
    print("restart every pane CLI before restarting the ticket-board notify-listener service")
    return 0


def verify_state(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    missing: list[str] = []
    for target in PANE_TARGETS:
        state = _read_state(_target_path(state_dir, target), target)
        if not state:
            missing.append(target)
    if missing:
        print("missing pane hook state: " + ", ".join(missing), file=sys.stderr)
        return 1
    print("pane hook state present for all notification targets")
    return 0


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Install and verify ticket-board pane idle hooks.")
    subparsers = parser.add_subparsers(dest="command", required=True)
    install_parser = subparsers.add_parser("install", help="install CLI hook binary and persistent hook configs")
    install_parser.add_argument("--home", default=str(Path.home()), help="home directory whose CLI configs will be edited")
    install_parser.add_argument(
        "--hook-source",
        default=str(_repo_root() / "scripts" / "ticket-board-pane-idle-hook"),
        help="hook writer source to install",
    )
    install_parser.add_argument(
        "--bin-path",
        default=str(Path.home() / ".local" / "bin" / HOOK_BASENAME),
        help="installed hook binary path",
    )
    install_parser.add_argument(
        "--seed-codex-hook-trust-if-new",
        action="store_true",
        help="seed Codex hook trust only when the owner has no existing hooks.json or hook trust records",
    )
    install_parser.set_defaults(func=install)

    verify_parser = subparsers.add_parser("verify-state", help="verify all live panes have written hook state")
    verify_parser.add_argument(
        "--state-dir",
        default=str(DEFAULT_PANE_STATE_DIR),
        help=f"pane state directory (default: {DEFAULT_PANE_STATE_DIR})",
    )
    verify_parser.set_defaults(func=verify_state)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
