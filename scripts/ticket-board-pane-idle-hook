#!/usr/bin/env python3
"""Write per-pane ticket notification idle/busy state from CLI hooks.

A pane target must be supplied with --target or TICKET_BOARD_PANE_TARGET.
Hooks outside managed panes no-op silently instead of inferring a target from
ambient tmux state.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import sys
import time
from pathlib import Path
from urllib import error as urllib_error
from urllib import request

def _env_first(environ: dict[str, str], *names: str) -> str:
    for name in names:
        value = environ.get(name, "").strip()
        if value:
            return value
    return ""


SESSION_ID_KEYS = {
    "session_id",
    "sessionid",
    "session_uuid",
    "sessionuuid",
    "conversation_id",
    "conversationid",
    "resume_id",
    "resumeid",
    "uuid",
}
UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)
SESSION_START_ACTIVE_WORK_SOURCES = {"clear", "compact", "resume"}
SESSION_START_HOOK_SOURCES = {"hermes.on_session_start"}


def _default_board_url(environ: dict[str, str]) -> str:
    return _env_first(environ, "TICKET_BOARD_URL", "PGU_TICKET_BOARD_URL") or "http://127.0.0.1:8770"


def _board_root_url(board_url: str) -> str:
    normalized = board_url.rstrip("/")
    if normalized.endswith("/api/tickets"):
        return normalized.removesuffix("/api/tickets")
    if normalized.endswith("/api"):
        return normalized.removesuffix("/api")
    return normalized


def _resolve_target(raw_target: str, environ: dict[str, str]) -> str | None:
    if raw_target:
        return raw_target
    env_target = _env_first(environ, "TICKET_BOARD_PANE_TARGET", "PGU_PANE_TARGET")
    if env_target:
        return env_target
    return None


def _project_from_target(target: str) -> str:
    session = target.split(":", 1)[0].strip()
    if "-" not in session:
        return ""
    return session.split("-", 1)[0].strip()


def _project_for_dirs(target: str, environ: dict[str, str]) -> str:
    return _env_first(environ, "TICKET_BOARD_PROJECT", "PGU_TICKET_BOARD_PROJECT") or _project_from_target(target)


def _role_for_target(target: str, environ: dict[str, str] | None = None) -> str:
    session = target.split(":", 1)[0].strip()
    if not session:
        return ""
    project = _env_first(environ or {}, "TICKET_BOARD_PROJECT", "PGU_TICKET_BOARD_PROJECT")
    if project:
        prefix = f"{project}-"
        if session.startswith(prefix):
            return session[len(prefix) :].strip().lower()
        return ""
    if "-" not in session:
        return ""
    return session.split("-", 1)[1].strip().lower()


def _runtime_base_dir(environ: dict[str, str]) -> Path:
    runtime_dir = environ.get("XDG_RUNTIME_DIR", "").strip()
    return Path(runtime_dir).expanduser() if runtime_dir else Path(f"/run/user/{os.getuid()}")


def _state_home(environ: dict[str, str]) -> Path:
    return Path(environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")).expanduser()


def _resolve_pane_state_dir(raw_state_dir: str, target: str, environ: dict[str, str]) -> Path | None:
    explicit = raw_state_dir.strip() or _env_first(environ, "TICKET_BOARD_PANE_STATE_DIR", "PGU_TICKET_BOARD_PANE_STATE_DIR")
    if explicit:
        return Path(explicit).expanduser()
    project = _project_for_dirs(target, environ)
    if project:
        return _runtime_base_dir(environ) / f"{project}-ticket-board" / "pane-state"
    print(
        "ticket-board-pane-idle-hook: cannot determine pane state directory; "
        "set --state-dir, TICKET_BOARD_PANE_STATE_DIR, or TICKET_BOARD_PROJECT",
        file=sys.stderr,
    )
    return None


def _resolve_pane_session_dir(raw_session_dir: str, target: str, environ: dict[str, str]) -> Path | None:
    explicit = raw_session_dir.strip() or _env_first(environ, "TICKET_BOARD_PANE_SESSION_DIR", "PGU_TICKET_BOARD_PANE_SESSION_DIR")
    if explicit:
        return Path(explicit).expanduser()
    project = _project_for_dirs(target, environ)
    if project:
        return _state_home(environ) / f"{project}-ticket-board" / "pane-sessions"
    print(
        "ticket-board-pane-idle-hook: cannot determine pane session directory; "
        "set --session-dir, TICKET_BOARD_PANE_SESSION_DIR, or TICKET_BOARD_PROJECT",
        file=sys.stderr,
    )
    return None


def _target_path(state_dir: Path, target: str) -> Path:
    safe = "".join(ch if ch.isalnum() or ch in ".-" else "_" for ch in target)
    return state_dir / f"{safe}.json"


def _write_state(state_dir: str | Path, target: str, state: str, *, source: str = "") -> Path:
    normalized_state = state.strip().lower()
    if normalized_state not in {"idle", "busy", "blocked"}:
        raise ValueError("pane hook state must be idle, busy, or blocked")
    target_dir = Path(state_dir).expanduser()
    target_dir.mkdir(parents=True, exist_ok=True)
    payload = {
        "target": target,
        "state": normalized_state,
        "updated_at": time.time(),
        "source": source,
    }
    path = _target_path(target_dir, target)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)
    return path


def _read_stdin_json(timeout: float = 0.1) -> object:
    if sys.stdin.isatty():
        return None
    chunks: list[bytes] = []
    deadline = time.monotonic() + max(0.0, timeout)
    try:
        fd = sys.stdin.fileno()
    except (OSError, ValueError):
        return None
    first_poll = True
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 and not first_poll:
            break
        first_poll = False
        try:
            readable, _, _ = select.select([fd], [], [], max(0.0, remaining))
        except (OSError, ValueError):
            return None
        if not readable:
            break
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            continue
        except OSError:
            return None
        if not chunk:
            break
        chunks.append(chunk)
    raw = b"".join(chunks).decode("utf-8", errors="replace")
    raw = raw.strip()
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {"raw": raw}


def _walk_json_values(value: object) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    if isinstance(value, dict):
        for raw_key, child in value.items():
            key = str(raw_key).replace("-", "_").replace(".", "_").lower()
            if isinstance(child, str):
                found.append((key, child.strip()))
            found.extend(_walk_json_values(child))
    elif isinstance(value, list):
        for child in value:
            found.extend(_walk_json_values(child))
    elif isinstance(value, str):
        found.append(("", value.strip()))
    return found


def _payload_string(payload: object, *names: str) -> str:
    wanted = {name.replace("-", "_").replace(".", "_").lower() for name in names}
    for key, value in _walk_json_values(payload):
        if key in wanted and value:
            return value
    return ""


def _session_start_source(payload: object) -> str:
    return _payload_string(payload, "source", "reason", "resume_source", "session_start_source").strip().lower()


def _extract_payload_session_id(payload: object) -> str:
    for key, value in _walk_json_values(payload):
        if value and key in SESSION_ID_KEYS:
            return value
    for _key, value in _walk_json_values(payload):
        if UUID_RE.match(value):
            return value
    return ""


def _env_session_id(environ: dict[str, str]) -> str:
    for key in (
        "TICKET_BOARD_PANE_SESSION_ID",
        "PGU_PANE_SESSION_ID",
        "CLAUDE_SESSION_ID",
        "CODEX_SESSION_ID",
        "GEMINI_SESSION_ID",
        "SESSION_ID",
    ):
        value = environ.get(key, "").strip()
        if value:
            return value
    return ""


def _extract_session_id(payload: object, environ: dict[str, str], explicit_session_id: str = "") -> str:
    if explicit_session_id.strip():
        return explicit_session_id.strip()
    payload_session_id = _extract_payload_session_id(payload)
    if payload_session_id:
        return payload_session_id
    env_session_id = _env_session_id(environ)
    if env_session_id:
        return env_session_id
    return ""


def _write_session(
    session_dir: str | Path,
    target: str,
    session_id: str,
    *,
    source: str = "",
    payload: object = None,
) -> Path | None:
    normalized_session_id = session_id.strip()
    if not normalized_session_id:
        return None
    target_dir = Path(session_dir).expanduser()
    target_dir.mkdir(parents=True, exist_ok=True)
    try:
        target_dir.chmod(0o700)
    except OSError:
        pass
    stored_payload = payload if isinstance(payload, (dict, list)) else None
    session_payload = {
        "target": target,
        "session_id": normalized_session_id,
        "updated_at": time.time(),
        "source": source,
        "payload": stored_payload,
    }
    path = _target_path(target_dir, target)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(session_payload, sort_keys=True) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except OSError:
        pass
    tmp.replace(path)
    try:
        path.chmod(0o600)
    except OSError:
        pass
    return path


def _session_id_from_file(path: Path) -> str:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return ""
    if not isinstance(parsed, dict):
        return ""
    return str(parsed.get("session_id") or "").strip()


def _should_write_session(
    *,
    target: str,
    existing_session_id: str,
    incoming_session_id: str,
    source: str,
    launched_session_id: str,
    record_session: bool,
    explicit_session_id: bool,
) -> bool:
    if not incoming_session_id:
        return False
    if not existing_session_id:
        return True
    if incoming_session_id == existing_session_id:
        return record_session
    if explicit_session_id:
        return True
    if launched_session_id:
        if incoming_session_id == launched_session_id:
            return True
        print(
            "ticket-board-pane-idle-hook: ignoring foreign session id for "
            f"{target}: incoming session {incoming_session_id!r} does not match launched session {launched_session_id!r}",
            file=sys.stderr,
        )
        return False
    print(
        "ticket-board-pane-idle-hook: ignoring foreign session id for "
        f"{target}: incoming session {incoming_session_id!r} from {source or 'unknown'} would replace "
        f"existing session {existing_session_id!r}",
        file=sys.stderr,
    )
    return False


def _ticket_number(ticket_id: str) -> int:
    match = re.search(r"(\d+)$", ticket_id)
    return int(match.group(1)) if match else -1


def _active_in_progress_ticket_for_role(
    role: str,
    *,
    board_url: str,
    timeout: float = 2.0,
) -> dict[str, object] | None:
    url = f"{_board_root_url(board_url)}/api/board"
    try:
        with request.urlopen(url, timeout=timeout) as response:
            response_body = response.read().decode("utf-8", errors="replace")
    except (OSError, urllib_error.URLError):
        return None
    try:
        parsed = json.loads(response_body)
    except json.JSONDecodeError:
        return None
    if not isinstance(parsed, dict):
        return None
    tickets = parsed.get("tickets")
    if not isinstance(tickets, list):
        return None
    matches = [
        ticket
        for ticket in tickets
        if isinstance(ticket, dict)
        and str(ticket.get("state", "")).strip() == "in_progress"
        and str(ticket.get("assignee", "")).strip().lower() == role
    ]
    if not matches:
        return None
    return sorted(matches, key=lambda ticket: _ticket_number(str(ticket.get("id", ""))))[0]


def _resume_context_for_ticket(ticket: dict[str, object], *, board_url: str, source: str) -> str:
    ticket_id = str(ticket.get("id", "")).strip().upper()
    title = str(ticket.get("title", "")).strip()
    ticket_url = f"{_board_root_url(board_url)}/api/tickets/{ticket_id}"
    title_suffix = f" -- {title}" if title else ""
    opening = _session_start_active_work_opening(source)
    return (
        f"{opening} You have ACTIVE work: {ticket_id}{title_suffix} "
        f"(in_progress, assigned to you). Re-read it: curl {ticket_url} . "
        "Resume where you left off; do NOT wait for a new prompt."
    )


def _session_start_active_work_opening(source: str) -> str:
    if source == "clear":
        return "Your session was just cleared."
    if source == "compact":
        return "Your context was just compacted."
    return "Your session just resumed."


def _is_session_start_hook_source(source: str) -> bool:
    return source.endswith(".SessionStart") or source in SESSION_START_HOOK_SOURCES


def _session_start_additional_context_output(
    *,
    target: str,
    payload: object,
    environ: dict[str, str],
) -> dict[str, object] | None:
    session_start_source = _session_start_source(payload)
    if session_start_source not in SESSION_START_ACTIVE_WORK_SOURCES:
        return None
    role = _role_for_target(target, environ)
    if not role:
        return None
    board_url = _default_board_url(environ)
    ticket = _active_in_progress_ticket_for_role(role, board_url=board_url)
    if ticket is None:
        return None
    return {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": _resume_context_for_ticket(ticket, board_url=board_url, source=session_start_source),
        }
    }


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Record a ticket-board pane idle/busy state for notification delivery when a pane target is given."
    )
    parser.add_argument("state", choices=["idle", "busy", "blocked"], help="pane lifecycle state to record")
    parser.add_argument("--target", default="", help="explicit pane target, for example project-ops:0.0")
    parser.add_argument("--source", default="", help="hook source label stored for diagnostics")
    parser.add_argument("--state-dir", default="", help="state directory; defaults to the current project")
    parser.add_argument(
        "--record-session",
        action="store_true",
        help="force session id recording even when the pane session file already exists",
    )
    parser.add_argument("--session-id", default="", help="explicit session id to record for pane resume launchers")
    parser.add_argument("--stdin-timeout", type=float, default=0.1, help="seconds to wait for hook stdin payload")
    parser.add_argument(
        "--session-dir",
        default="",
        help="session id directory; defaults to the current project",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    target = _resolve_target(args.target.strip(), os.environ)
    if target is None:
        return 0
    state_dir = _resolve_pane_state_dir(args.state_dir, target, os.environ)
    session_dir = _resolve_pane_session_dir(args.session_dir, target, os.environ)
    if state_dir is None or session_dir is None:
        return 0
    _write_state(state_dir, target, args.state, source=args.source)
    session_path = _target_path(session_dir, target)
    existing_session_id = _session_id_from_file(session_path)
    should_wait_for_session_payload = args.record_session or not existing_session_id
    payload = _read_stdin_json(timeout=args.stdin_timeout if should_wait_for_session_payload else 0.0)
    session_id = _extract_session_id(payload, os.environ, args.session_id)
    launched_session_id = args.session_id.strip() or _env_session_id(os.environ)
    if _should_write_session(
        target=target,
        existing_session_id=existing_session_id,
        incoming_session_id=session_id,
        source=args.source,
        launched_session_id=launched_session_id,
        record_session=args.record_session,
        explicit_session_id=bool(args.session_id.strip()),
    ):
        _write_session(session_dir, target, session_id, source=args.source, payload=payload)
    if args.state == "idle" and _is_session_start_hook_source(args.source):
        output = _session_start_additional_context_output(target=target, payload=payload, environ=os.environ)
        if output is not None:
            print(json.dumps(output, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
