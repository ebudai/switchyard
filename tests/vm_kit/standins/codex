#!/usr/bin/python3
"""A stand-in for the codex CLI, for a test tenant in a tests/vm_kit VM only (SYRD-857).

It answers what `switchyard new` and a role pane ask of a signed-in Codex account, with no provider and no network:
- `--version`, and `login status` saying it is signed in;
- the folder-trust prompt: a folder it opens at the prompt is trusted, as answering Codex's "Trust this folder?"
  with yes records it (`[projects."<dir>"] trust_level = "trusted"` in ~/.codex/config.toml);
- a pane: it stays the foreground process and fires the hooks Switchyard installed in ~/.codex/hooks.json as Codex
  does -- SessionStart once, then UserPromptSubmit and Stop around every line it reads -- so the board sees the pane
  go busy and idle, and the listener's deliveries are real;
- a line starting with `!` runs as a shell command in the pane, as a CLI's shell escape does, so it is the pane's own
  child: what the board requires of a role's write (tests/vm_kit/role_run.py types such lines).

It refuses everywhere else. It runs only where the kit's first-boot seed wrote /etc/switchyard-test-vm with the
kit's text, which nothing else writes. Copied onto a real host it exits 3, says why, and records nothing.
"""

import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

MARKER = Path("/etc/switchyard-test-vm")
MARKER_TEXT = "switchyard-test-vm: a disposable review VM; stand-in agent CLIs are allowed here\n"
HOME = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")


def refuse_outside_a_kit_vm() -> None:
    try:
        ours = MARKER.read_text() == MARKER_TEXT
    except OSError:
        ours = False
    if not ours:
        sys.stderr.write(f"codex stand-in: refusing: this is not a switchyard-test-vm review VM ({MARKER} is "
                         "missing)\ncodex stand-in: install the real Codex CLI; this one answers sign-in without "
                         "signing anybody in.\n")
        raise SystemExit(3)


def trust(directory: str) -> None:
    config = HOME / "config.toml"
    HOME.mkdir(parents=True, exist_ok=True)
    text = config.read_text() if config.exists() else ""
    if f'[projects."{directory}"]' not in text:
        with config.open("a") as out:
            out.write(f'\n[projects."{directory}"]\ntrust_level = "trusted"\n')


def fire(event: str, session: str, **extra: str) -> None:
    """Each command hooks.json names for `event`, with Codex's payload on stdin."""
    try:
        groups = json.loads((HOME / "hooks.json").read_text()).get("hooks", {}).get(event, [])
    except (OSError, ValueError):
        return
    payload = json.dumps({"session_id": session, "hook_event_name": event, "cwd": os.getcwd(), **extra})
    for group in groups:
        for hook in group.get("hooks", []):
            if hook.get("type") == "command" and hook.get("command"):
                try:
                    subprocess.run(["bash", "-c", hook["command"]], input=payload, text=True, timeout=60,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except subprocess.TimeoutExpired:
                    pass


def main(argv: list[str]) -> int:
    refuse_outside_a_kit_vm()
    first = argv[0] if argv else ""
    if first == "--version":
        print("codex-cli 0.0.0-switchyard-test-vm-standin")
        return 0
    if first == "login":
        if argv[1:2] == ["status"]:
            print("Logged in using ChatGPT (switchyard-test-vm stand-in)")
        return 0
    if first == "exec":
        print("switchyard-test-vm stand-in: no model here")
        return 0
    trust(os.getcwd())
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    if top:
        trust(top)
    session = str(uuid.uuid4())
    fire("SessionStart", session, source="startup")
    print("codex stand-in ready (switchyard-test-vm)\n> ", end="", flush=True)
    for raw in sys.stdin:
        line = raw.rstrip("\n")
        if line == "/exit":
            return 0
        fire("UserPromptSubmit", session, prompt=line)
        if line.startswith("!"):
            subprocess.run(["bash", "-c", line[1:]])
        else:
            print(f"(stand-in) received {len(line)} characters at {time.strftime('%H:%M:%S')}", flush=True)
        fire("Stop", session)
        print("> ", end="", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
